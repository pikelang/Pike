test_any([[
  Sql.Sql sql = Sql.Sql("null://");
  return sql->query("INSERT INTO foo (foo, bar) VALUES (%s, %s) WHERE bar = %d",
                    0, "blah", 0)[0]->query;
]], "INSERT INTO foo (foo, bar) VALUES (%s, %s) WHERE bar = %d")

test_any([[
  Sql.Sql sql = Sql.Sql("null://");
  return sql->query("INSERT INTO foo (foo, bar) VALUES (%s, %s) WHERE bar = %d",
                    0, "blah", 0)[0]->bindings_query;
]], "INSERT INTO foo (foo, bar) VALUES (NULL, :arg0) WHERE bar = 0")

test_any([[
  Sql.Sql sql = Sql.Sql("null://");
  return sql->query("INSERT INTO foo (foo, bar) VALUES (%s, %s) WHERE bar = %d",
                    0, "blah", 0)[0]->formatted_query;
]], "INSERT INTO foo (foo, bar) VALUES (NULL, 'quote(\"blah\")') WHERE bar = 0")

test_do([[
  catch {
    add_constant( "db", Sql.Sql("mysql://localhost") );
  };
]])

test_any([[
#pragma no_deprecation_warnings
  Sql.Sql sql = Sql.Sql("null://");
  return sql == sql->master_sql;
]], 1)

test_do([[
  add_constant("tds_binding_test", class {
    inherit Sql.tds;
    protected void create() {} // No server is needed to test query preparation.
    string normalize(mixed query, array(mixed) args) {
      return (string)normalize_query(query, args);
    }
  }());
]])

test_any([[
  return functionp(tds_binding_test->query);
]], 1)

test_any([[
  return tds_binding_test->normalize("VALUES (:arg0)",
                                     ({ ([ ":arg0":"O'Reilly" ]) }));
]], "VALUES ('O''Reilly')")

test_any([[
  return tds_binding_test->normalize("VALUES (%s)", ({ "O'Reilly" }));
]], "VALUES ('O''Reilly')")

test_any([[
  object query = tds_binding_test->compile_query("VALUES (:name)");
  return tds_binding_test->normalize(query,
                                     ({ ([ ":name":"O'Reilly" ]) }));
]], "VALUES ('O''Reilly')")

test_do( add_constant("tds_binding_test") )

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  Concurrent.Future(<Sql.Result>) future =
    db->promise_query("SELECT 42");
  Sql.Result result = future->get();
  if (result->num_rows() != 1 || result->eof()) return 0;
  if (sizeof(result->fetch_row()) != 3) return 0;
  return result->eof();
]], 1)

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  Concurrent.Future(<Sql.Result>) future =
    db->promise_query("SELECT 42", 0, 0, (["discard_records":0]));
  return future->get()->num_rows();
]], 0)

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  Concurrent.Future(<Sql.Result>) future =
    db->promise_query("SELECT 42", 0, 0, (["max_records":0]));
  mixed err = catch(future->get());
  return arrayp(err) && has_prefix(err[0], "Too many records");
]], 1)

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  Concurrent.Future(<Sql.Result>) future =
    db->promise_query("SELECT 42", 0, 0, (["min_records":2]));
  mixed err = catch(future->get());
  return arrayp(err) && has_prefix(err[0], "Insufficient number");
]], 1)

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  Concurrent.Future(<Sql.Result>) future = db->promise_query(
    "SELECT 42", lambda(array row, object result, array collected) {
      return ({42});
    }, (["min_records":1]));
  return future->get()->fetch_row()[0];
]], 42)

test_any([[
#pragma no_experimental_warnings
  Sql.Connection db = Sql.Sql("null://");
  return !!catch(db->promise_query("SELECT 42", 0, 0,
                                   (["unknown":1])));
]], 1)

ifefun(db,[[
  test_equal( db->query("select 1"), ({ ([ "1":"1" ]) }) )
  test_eq( db->big_query("select 1")->num_rows(), 1 )
  test_eq( db->big_query("select 1,2")->num_fields(), 2 )
  test_equal( db->big_query("select 1")->fetch_fields()->name, ({ "1" }) )
  test_eq( 1, [[#pragma no_deprecation_warnings
    objectp(db->big_query("select 1"))
  ]])
  test_eq( db->big_query("select 1")->index, 0 )
  test_any([[
    object q=db->big_query("show status");
    q->seek(2);
    return q->index;
  ]], 2 )
  test_equal( db->big_query("select 1,2")->fetch_row(), ({ "1", "2" }) )
  test_do([[
    object q=db->big_query("show status");
    q->seek( q->num_rows()+7 );
  ]])
  test_do( add_constant("db") )
]])

test_eq( Sql.sql_array_result(({(["1":"1"])}))->num_rows(), 1 )
test_eq( Sql.sql_array_result(({(["a":"1","b":"2"])}))->num_fields(), 2 )
test_equal( Sql.sql_array_result(({(["a":"1","b":"2"])}))->fetch_fields(),
            ({ ([ "name":"a" ]), ([ "name":"b" ]) }) )
test_eq( Sql.sql_array_result(({(["1":"1"])}))->index, 0 )
test_any([[
  object q=Sql.sql_array_result(({(["a":"1"]),(["a":"2"])}));
  q->seek(1);
  return q->index;
]], 1 )
test_equal( Sql.sql_array_result(({(["a":"1"])}))->fetch_row(), ({ "1" }) )
test_do([[
  object q=Sql.sql_array_result(({(["a":"1"]),(["a":"2"])}));
  q->seek(77);
]])

dnl status_command_complete() on the result of a query that failed while
dnl it executed (SELECT 1/0) should return, in a child process that must
dnl end within 30 s. Without the fix it waits forever, on every run.
dnl Needs PIKE_TEST_PGSQL_URL.
cond([[!all_constants()->OMIT_SLOW_TESTS]], [[
cond([[getenv("PIKE_TEST_PGSQL_URL")]], [[
  test_any([[
    string child = #{
      object db = Sql.Sql(getenv("PIKE_TEST_PGSQL_URL"));
      object r = db->big_query("SELECT 1/0");
      catch { while (r->fetch_row()); };
      r->status_command_complete();
      return 0;
    #};
    Process.Process p =
      Process.Process(RUNPIKE_ARRAY + ({ "-e", child }),
                      ([ "stdout": Stdio.File("/dev/null", "w") ]));
    int start = time();
    while (!p->status() && time() - start < 30) sleep(0.1);
    if (!p->status()) {
      p->kill(signum("SIGKILL"));
      p->wait();
      return "status_command_complete() waited for 30 s";
    }
    if (int rc = p->wait()) return sprintf("exited with %d", rc);
    return 0;
  ]], 0)
]])
]])

dnl Freed Sql.pgsql connections should be closed on the server, without
dnl "Operation not supported in a signal context": counts the server's
dnl connections before and after freeing 20, each after a failed query
dnl (SELECT 1/0), in a child process. Fails on every run without the
dnl fix. The child still holds a connection when it exits, which must
dnl not print "Cannot access parent of destructed object". Needs a
dnl PostgreSQL server: PIKE_TEST_PGSQL_URL, e.g.
dnl pgsql://user:password@localhost/database, for a user that no other
dnl client uses meanwhile.
cond([[!all_constants()->OMIT_SLOW_TESTS]], [[
cond([[getenv("PIKE_TEST_PGSQL_URL")]], [[
  test_any([[
    mapping r = Process.run(RUNPIKE_ARRAY + ({ "-e", #{
      string url = getenv("PIKE_TEST_PGSQL_URL");
      string user = Standards.URI(url)->user;
      int count(object db) {
        return (int)db->query("SELECT count(*) AS n FROM pg_stat_activity "
                              "WHERE usename = %s", user)[0]->n;
      };
      void use_one() {
        object db = Sql.Sql(url);
        catch { db->query("SELECT 1/0"); };
      };
      object watch = Sql.Sql(url);
      int before = count(watch);
      for (int i = 0; i < 20; i++) use_one();
      sleep(1);
      write("%d %d\n", before, count(watch));
      return 0;
    #} }));
    int before, after;
    sscanf(r->stdout, "%d %d", before, after);
    if (r->exitcode || has_value(r->stderr, "signal context") ||
        has_value(r->stderr, "destructed object") || after != before)
      return sprintf("exit %d, %d connections before, %d after 20 freed: %s",
                     r->exitcode, before, after, r->stderr);
    return 0;
  ]], 0)
]])
]])

dnl Freeing Sql.pgsql connections should print nothing from their
dnl backend thread, such as "Bad argument 1 to create(). Expected
dnl function." Frees 10 connections in a child process. Needs
dnl PIKE_TEST_PGSQL_URL.
cond([[!all_constants()->OMIT_SLOW_TESTS]], [[
cond([[getenv("PIKE_TEST_PGSQL_URL")]], [[
  test_any([[
    mapping r = Process.run(RUNPIKE_ARRAY + ({ "-e", #{
      string url = getenv("PIKE_TEST_PGSQL_URL");
      void use_one() { Sql.Sql(url)->query("SELECT 1"); };
      for (int i = 0; i < 10; i++) use_one();
      sleep(0.5);
      return 0;
    #} }));
    if (r->exitcode || has_value(r->stderr, "Expected function"))
      return sprintf("exit %d: %s", r->exitcode, r->stderr);
    return 0;
  ]], 0)
]])
]])

END_MARKER
