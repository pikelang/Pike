// -*- pike -*- TEST: RUN-AS-PIKE-SCRIPT
// Regression tests for forkd channel closure (issues 6092 and 6153).

#if constant(Process.ForkdDecoder)
class RemoteProcess
{
  inherit Process.Process;

  Stdio.File peer;
  int polls;
  int notifications;
  array(int) callback_results = ({});

  protected void create()
  {
    process_fd = Stdio.File();
    peer = process_fd->pipe(Stdio.PROP_BIDIRECTIONAL);
    process_backend = Pike.SmallBackend();
    process_backend->add_file(process_fd);
    process_fd->set_nonblocking(got_data, UNDEFINED, got_close);
    __callback = lambda(object process) {
      notifications++;
      // A callback must be able to retrieve the completed result.
      if (process->status() == 2) callback_results += ({ process->wait() });
    };
  }

  protected void do_poll(float t)
  {
    // Bound regressions that would otherwise spin forever after EOF.
    if (++polls > 30) error("Process.wait() did not terminate after EOF.\n");
    ::do_poll(min(t, 0.01));
  }

  void packet(string tag, mixed value)
  {
    string data = encode_value(({ tag, value }));
    string frame = sprintf("%4c%s", sizeof(data), data);
    if (peer->write(frame) != sizeof(frame)) error("Failed to send packet.\n");
  }

  void close_peer()
  {
    peer->close();
  }

  void await_state(int wanted)
  {
    while (__status != wanted) do_poll(0.01);
  }

  void await_close()
  {
    while (process_backend) do_poll(0.01);
  }

  void repeat_close()
  {
    got_close(0);
  }

  int poll_loop_once()
  {
    do_poll_loop();
    return !!process_poll;
  }
}

class NotificationChild {
  inherit Process.Process;
  protected void create() {}
  int pid() { return 1234; }
  int status() { return 2; }
  int last_signal() { return 0; }
  int wait() { return 37; }
}

class NotificationStream {
  inherit Tools.Standalone.forkd.ForkStream;
  array packets = ({});
  int interrupted;
  protected void send_packet(string tag, mixed value) {
    packets += ({ ({ tag, value }) });
    if (tag == "PID" && !interrupted) {
      interrupted = 1;
      // Simulate a SIGCHLD callback during PID packet creation.
      got_callback(pid);
    }
  }
  void begin() { pid = NotificationChild(); send_pid(); got_callback(pid); }
  void again() { got_callback(pid); }
}

class TestProcessModule {
  inherit Process;
  int die_before_ack;
  int reject_handoff;
  array test_daemons = ({});
  Stdio.File control_peer;
  protected int assert_forkd() {
    if (!die_before_ack && !reject_handoff) return ::assert_forkd();
    die_before_ack = 0;
    forkd_pipe = Stdio.File();
    control_peer = forkd_pipe->pipe(Stdio.PROP_BIDIRECTIONAL|
                                    Stdio.PROP_SEND_FD);
    // A live control peer but no reader for the submitted request descriptor.
    mapping options = ([ "forkd": 0 ]);
    if (!reject_handoff) options->fds = ({ control_peer });
    forkd_pid = spawn_pike(({ "-e", "sleep(.2);" }), options);
    test_daemons += ({ forkd_pid });
    if (reject_handoff) {
      reject_handoff = 0;
      control_peer->close();
    }
    return 1;
  }
  void cleanup() {
    if (control_peer) control_peer->close();
    if (forkd_pid) { forkd_pid->kill(9); forkd_pid->wait(); }
    foreach (test_daemons, object daemon) { daemon->kill(9); daemon->wait(); }
  }
}

void check_notifications()
{
  object stream = NotificationStream();
  stream->begin();
  if (!equal(stream->packets, ({ ({ "PID", 1234 }) })))
    error("A native status report ran synchronously.\n");
  Pike.DefaultBackend(0.0);
  array expected = ({ ({ "PID", 1234 }), ({ "SIGNAL", 0 }), ({ "EXIT", 37 }) });
  if (!equal(stream->packets, expected)) error("Invalid PID/EXIT ordering.\n");
  stream->again(); Pike.DefaultBackend(0.0);
  if (!equal(stream->packets, expected)) error("Duplicate terminal report.\n");
}

class ReentrantModule {
  inherit TestProcessModule;
  int first = 1;
  int nested_result;
  protected int assert_forkd() {
    if (first) {
      first = 0;
      // Simulate a native callback while the startup lock is held.
      nested_result = Process(({ "/bin/sh", "-c", "exit 11" }),
                              ([ "forkd": 1 ]))->wait();
    }
    return ::assert_forkd();
  }
}

void check_reentrant()
{
  object module = ReentrantModule();
  object child = module->Process(({ "/bin/sh", "-c", "exit 3" }),
                                  ([ "forkd": 1 ]));
  int result = child->wait();
  module->cleanup();
  if (result != 3 || module->nested_result != 11)
    error("Reentrant forkd startup failed.\n");
}

void check_failed_submit()
{
  object module = TestProcessModule();
  module->reject_handoff = 1;
  mixed err = catch {
    module->Process(({ "/bin/sh", "-c", "exit 0" }), ([ "forkd": 1 ]));
  };
  if (!err || !has_prefix(err[0], "Failed to submit forkd spawn request"))
    error("Broken control channel was not rejected: %O\n", err);
  object child = module->Process(({ "/bin/sh", "-c", "exit 7" }),
                                  ([ "forkd": 1 ]));
  int result = child->wait();
  module->cleanup();
  if (result != 7) error("Forkd did not recover after a failed submission.\n");
}

void check_ack_death()
{
  object module = TestProcessModule();
  module->die_before_ack = 1;
  mixed err = catch {
    module->Process(({ "/bin/sh", "-c", "exit 0" }), ([ "forkd": 1 ]));
  };
  if (!err || !has_prefix(err[0], "Failed to create spawn request."))
    error("Unexpected result after daemon death before ACK: %O\n", err);
  object child = module->Process(({ "/bin/sh", "-c", "exit 7" }),
                                  ([ "forkd": 1 ]));
  int result = child->wait();
  module->cleanup();
  if (result != 7) error("Forkd did not recover after failed ACK.\n");
}

#if constant(Thread.Thread)
void run_job(object module, int id)
{
  int expected = id % 64;
  string payload = sprintf("job%d:", id) + "x" * (id % 257);
  Stdio.File input = Stdio.File();
  Stdio.File output = input->pipe();
  Stdio.File null = Stdio.File("/dev/null", "rw");
  object child = module->Process(
    ({ "/bin/sh", "-c", "printf '%s' \"$1\"; exit \"$2\"",
       "forkd-test", payload, (string)expected }),
    ([ "forkd": 1, "stdin": null, "stdout": output, "stderr": null,
       "callback": lambda(object process) {
         if (process->status() == 2 && process->wait() != expected)
           error("Incorrect forkd callback result for job %d.\n", id);
       } ]));
  output->close();
  if (input->read() != payload || child->wait() != expected ||
      child->wait() != expected || child->status() != 2)
    error("Incorrect forkd output or result for job %d.\n", id);
  input->close(); null->close();
}

void check_concurrent()
{
  object module = TestProcessModule();
  Thread.Queue ready = Thread.Queue(), go = Thread.Queue();
  Thread.Queue errors = Thread.Queue();
  int done;
  object backend = Thread.Thread(lambda() {
    mixed err = catch { while (!done) Pike.DefaultBackend(0.005); };
    if (err) errors->write(err);
  });
  array workers = ({});
  for (int w = 0; w < 4; w++) {
    workers += ({ Thread.Thread(lambda(int worker) {
      ready->write(1); go->read();
      mixed err = catch {
        for (int i = 0; i < 12; i++) run_job(module, worker * 12 + i);
      };
      if (err) errors->write(err);
    }, w) });
  }
  for (int i = 0; i < 4; i++) ready->read();
  for (int i = 0; i < 4; i++) go->write(1);
  foreach (workers, object worker) worker->wait();
  done = 1; backend->wait(); module->cleanup();
  if (sizeof(errors)) throw(errors->read());
}
#endif


int main()
{
  int checks;
  foreach (({ 0, 1, -1 }), int state) {
    foreach (({ 0, 1 }), int close_before_wait) {
      object process = RemoteProcess();
      if (state >= 0) {
        process->packet("PID", getpid());
        process->await_state(0);
      }
      if (state == 1) {
        process->packet("STOP", 0);
        process->await_state(1);
      }
      int notifications = process->notifications;
      process->close_peer();
      if (close_before_wait) process->await_close();
      if (process->wait() != 255 || process->status() != 2)
        error("Incorrect result after EOF in state %d.\n", state);
      if (process->wait() != 255)
        error("Repeated wait lost the result in state %d.\n", state);
      if (process->notifications != notifications + 1 ||
          !equal(process->callback_results, ({ 255 })))
        error("Missing terminal callback in state %d.\n", state);
      process->repeat_close();
      if (process->notifications != notifications + 1)
        error("Repeated EOF sent another callback.\n");
      checks++;
      destruct(process);
    }
  }

  object process = RemoteProcess();
  process->packet("PID", getpid());
  process->packet("EXIT", 37);
  process->close_peer();
  if (process->wait() != 37 || process->wait() != 37 ||
      !equal(process->callback_results, ({ 37 })))
    error("Normal EXIT result was not preserved.\n");
  int notifications = process->notifications;
  process->repeat_close();
  if (process->wait() != 37 || process->notifications != notifications)
    error("EOF overwrote the EXIT result or repeated its callback.\n");
  destruct(process);

  process = RemoteProcess();
  process->packet("PID", getpid());
  process->await_state(0);
  process->close_peer();
  if (process->poll_loop_once() || process->wait() != 255)
    error("Polling rescheduled itself after EOF.\n");
  destruct(process);
  check_notifications();
  check_reentrant();
  check_failed_submit();
  check_ack_death();
#if constant(Thread.Thread)
  check_concurrent();
#endif
  write("%d forkd channel-closure scenarios and process regressions passed.\n",
        checks + 2);
  return 0;
}
#else
int main()
{
  write("Skipping forkd tests: descriptor passing is unavailable.\n");
  return 0;
}
#endif
