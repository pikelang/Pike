// -*- mode: Pike; c-basic-offset: 4; -*-
#pike __REAL_VERSION__

//! Fuse - Filesystem in USErspace
//!
//! FUSE (Filesystem in USErspace) provides a simple interface for
//! userspace programs to export a virtual filesystem to the Linux
//! kernel.  FUSE also aims to provide a secure method for non
//! privileged users to create and mount their own filesystem
//! implementations.
//!
//! See http://sourceforge.net/projects/fuse/ for more information
//!
//! This module maps the Fuse library more or less directly to pike.
//!
//! In order to create a filesystem, create a subclass of the
//! @[Operations] class, clone it and pass it to the @[run] method.
//!
//! You do not need to implemnent all functions, but at least getattr,
//! readdir and read are needed to make a useable filesystem.
//!
//! A tip: ERRNO constants are available in the System module, and if
//! one is missing /usr/include/asm[-generic]/errno.h can be included
//! in pike programs on Linux.

#if constant(@module@.run)
inherit @module@;

class Operations
//! This is the interface you have to implement to write a FUSE filesystem
//! If something goes wrong in your callback, always return errno.
//! Unless the function returns a specific value (Stat, string or similar),
//! return @expr{0@} (zero) if all is well.
//!
//! You do not have to implement all functions. Unimplemented
//! functions have a default implementation that returns @[System.ENOSYS].
{
    //! Unkown directory entry type
    final constant DT_UNKNOWN = 0;

    //! FIFO directory entry
    final constant DT_FIFO = 1;

    //! Character special directory entry
    final constant DT_CHR = 2;

    //! Directory directory entry
    final constant DT_DIR = 4;

    //! Block special directory entry
    final constant DT_BLK = 6;

    //! Normal file directory entry
    final constant DT_REG = 8;

    //! Symlink directory entry
    final constant DT_LNK = 10;

    //! Socket directory entry
    final constant DT_SOCK = 12;

    //! Open for append
    final constant O_APPEND=02000;

    //! Mask for read/write/rdwr
    final constant O_ACCMODE=3;

    //! Open read only
    final constant O_RDONLY=0;

    //! Open write only
    final constant O_WRONLY=1;

    //! Open read/write only
    final constant O_RDWR=2;

    //! lock() mode operations.
    final constant F_GETLK = Fuse.F_GETLK;
    final constant F_SETLK = Fuse.F_SETLK;
    final constant F_SETLKW = Fuse.F_SETLKW;
    final constant F_RDLCK = Fuse.F_RDLCK;
    final constant F_WRLCK = Fuse.F_WRLCK;
    final constant F_UNLCK = Fuse.F_UNLCK;

    //! Stat a file.
    //! @note
    //! This function is required.
    //! @returns
    //! A @[Stdio.Stat] object or an errno.
    //!
    Stdio.Stat|int(1..) getattr( string path, mixed|void open_handle );

    //! Read a symlink.
    //! @returns
    //! The symlink contents or errno
    optional string|int(1..) readlink( string path );

    //! Open a directory.
    //!
    //! @param path
    //!   Path to the directory.
    //!
    //! @returns
    //!   Returns @expr{0@} (zero) or a non-integer (typically an object)
    //!   on success and the errno on failure. The returned value will
    //!   be passed to @[readdir()], @[fsyncdir()] and @[releasedir()]
    //!   as the @tt{opendir_handle@} argument. It will be released after
    //!   the @[releasedir()] call when the directory is closed.
    //!
    //! @note
    //!   New in Pike 9.0 and FUSE 2.3.
    optional mixed opendir(string path);

    //! Get directory contents.
    //!
    //! @param path
    //!   Path to the directory.
    //!
    //! @param callback
    //!   Filler callback. Call the callback once per entry in the
    //!   directory with the filename as the first argument. The optional
    //!   second argument is the next value for @[off]. A @[Stdio.Stat]
    //!   object for the entry may optionally be provided with the third
    //!   argument. Returns @expr{1@} on failure (typically due to the
    //!   buffer being full), at which time @[readdir()] should return
    //!   @expr{0@}. The kernel will then call @[readdir()] again with
    //!   the latest reported @[off].
    //!
    //! @param off
    //!   Directory offset to start at. The first call after @[opendir()]
    //!   has a value of @expr{0@}. Later calls have the value from
    //!   the last call of @[callback].
    //!
    //! @param opendir_handle
    //!   The value that was returned from @[opendir()].
    //!
    //! @note
    //!   Do not forget to add entries for @expr{"."@} end @expr{".."@}.
    //!
    //! @note
    //! This function is required.
    //!
    //! @returns
    //!   errno or @expr{0@}. Returning @expr{0@} after a failed
    //!   call of @[callback] indicates that there are entries left.
    //!   Otherwise returning @expr{0@} indicates that all entries
    //!   have been registered.
    int readdir( string path,
                 function(string, int|void, Stdio.Stat|void:int) callback,
                 int|void off,
                 mixed|void opendir_handle);

    //! Sync directory changes to disc.
    //!
    //! @param path
    //!   Path to the directory.
    //!
    //! @param datasync
    //!   Whether the caller called @tt{fdatasync()@} (@expr{1@}) or
    //!   @tt{fsync()@} (@expr{0@}).
    //!
    //! @param opendir_handle
    //!   The value returned from @[opendir()].
    //!
    //! @returns
    //! errno or 0
    //!
    //! @note
    //!   New in Pike 9.0 and FUSE 2.3.
    //!
    //! @seealso
    //!   @[fsync()]
    optional int fsyncdir( string path, int(0..1) datasync,
                           mixed opendir_handle );

    //! Close a directory opened via @[opendir()].
    //!
    //! @param path
    //!   Path to the directory (if still valid).
    //!
    //! @param opendir_handle
    //!   The value that was returned from @[opendir()].
    //!
    //! @note
    //!   New in Pike 9.0 and FUSE 2.3.
    optional void releasedir(string path, mixed|void opendir_handle);

    //! Create a node (file, device special, or named pipe).
    //! See man 2 mknod
    //! @returns
    //! errno or 0
    optional int mknod( string path, int mode, int rdev );

    //! Create a directory.
    //! @returns
    //! errno or 0
    optional int mkdir( string path, int mode );

    //! Remove a file
    //! @returns
    //! errno or 0
    optional int unlink( string path );

    //! Remove a directory
    //! @returns
    //! errno or 0
    optional int rmdir( string path );

    //! Create a symlink from source to destination.
    //! @returns
    //! errno or 0
    optional int symlink( string source, string destination );

    //! Create a hard link from source to destination.
    //! @returns
    //! errno or 0
    optional int link( string source, string destination );

    //! Rename @[source] to @[destination].
    //! @returns
    //! errno or 0
    optional int rename( string source, string destination );

    //! Change the permission of a file or directory
    //! @returns
    //! errno or 0
    optional int chmod( string path, int mode, mixed|void open_handle );

    //! Change the owner of a file or directory
    //! @returns
    //! errno or 0
    optional int chown( string path, int uid, int gid, mixed|void open_handle );

    //! Shrink or enlarge a file
    //! @returns
    //! errno or 0
    optional int truncate( string path, int new_length,
                           mixed|void open_handle );

#pragma no_deprecation_warnings
    //! Set access and modification time. The arguments are the number
    //! of seconds since jan 1 1970 00:00.
    //!
    //! This function is deprecated, utimens is the recommended
    //! method.
    //!
    //! @returns
    //! errno or 0
    optional __deprecated__ int utime( string path, int atime, int mtime );

    //! Set access and modification time, with nanosecond resolution.
    //! The arguments are the number of nanoseconds since jan 1 1970
    //! 00:00.
    //!
    //! @returns
    //! errno or 0
    optional int utimens( string path, int atime, int mtime,
                          mixed|void open_handle )
    {
        utime( path, atime/1000000,mtime/100000 );
    }
#pragma deprecation_warnings

    //! Open @[path]. @[mode] is as for the system call open.
    //! @expr{(mode & O_ACCMODE)@} is one of @[O_RDONLY], @[O_WRONLY]
    //! or @[O_RDWR].
    //! The mode can also contain other flags, most notably @[O_APPEND].
    //! @note
    //! You do not really have to implement this function.
    //! It's useful to start prefetch and to cache open files, and
    //! check that the user has permission to read/write the file.
    //!
    //! @returns
    //!   Returns @expr{0@} or a non-integer value on success, and
    //!   an errno on failure. The returned value will be passed as
    //!   the @tt{open_handle@} to several functions.
    //!
    //! @seealso
    //!   @[creat()], @[release()]
    optional int|mixed open( string path, int mode );

    //! Read data from a file. You have to return at most @[len]
    //! bytes, wunless an error occurs, or there is less than len bytes
    //! of data still left to read.
    //! @returns
    //! errno or the data
    string|int(1..) read( string path, int len, int offset,
                          mixed|void open_handle );

    //! Write data to the file. Should write all data.
    //! @returns
    //! errno or amount written (bytes)
    optional int write( string path, string data, int offset,
                        mixed|void open_handle );

    //! Stat a filesystem.
    //! Mapping as from @[filesystem_stat]
    //! @note
    //!   required for @tt{'df'@} support, without this function there
    //!   is an error each time @tt{'df'@} is run.
    optional mapping(string:int) statfs( string path );

    //! The inverse of @[open()] and @[creat()].
    //!
    //! @note
    //! The file might very well be openend multiple times.
    //! Keep reference counts or use the @[open_handle] to keep track.
    //!
    //! @seealso
    //!   @[open()], @[creat()]
    optional int release( string path, mixed|void open_handle );

    //! Flush data and user-data to disk. Not required.
    //! If the @[datasync] parameter is non-zero, then only the user data
    //! should be flushed, not the meta data.
    //!
    //! @seealso
    //!   @[fsyncdir()]
    optional int fsync( string path, int datasync, mixed|void open_handle );

    //! Return a list of all available extended attributes on @[path]
    optional array(string)|int listxattr(string path);

    //! Remove the extended attribute @[name] from @[path]
    optional int removexattr(string path, string name);

    //! Get the extended attribute @[name] on @[path]
    optional string getxattr( string path, string name );

    //! Set the extended attrbiute @[name] on @[path] to @[value]
    optional int setxattr(string path, string name, string value, int flags );

    //! Create and open or just open the given @[path].
    //!
    //! @returns
    //!   Returns @expr{0@} or a non-integer value on success, and
    //!   an errno on failure. The returned value will be passed as
    //!   the @tt{open_handle@} to several functions.
    //!
    //! @seealso
    //!   @[open()], @[release()]
    optional int|mixed creat( string path, int mode, int flag );

    //! Return if the user is allowed to access the @[path]. If the
    //! 'default_permissions' mount option is given, this method is not
    //! called.
    optional int access( string path, int mode );

    //! Lock, unlock or test for the existence of record locks (POSIX
    //! file locking). The owner of the lock is identified by
    //! @expr{how->owner@}
    //!
    //! If you only need local file-locking on the computer the
    //! filesystem is mounted on you do not need to implement this
    //! interface. This is only needed for network filesystems that
    //! want locking to work over the network.
    //!
    //! The operation mode depends on the @[mode] argument.
    //!
    //! @param mode
    //! @int mode
    //!   @value F_SETLK
    //!
    //!     Acquire a lock (when @expr{how->type@} is @[F_RDLCK] or @[F_WRLCK])
    //!     or release a lock (when @expr{how->type@} is @[F_UNLCK]) on the
    //!     bytes specified by the @expr{how->whence@}, @expr{how->start@},
    //!     and @expr{how->len@} fields of lock.  If a conflicting lock is held
    //!     by another process, you should return @[System.EACCES] or
    //!     @[System.EAGAIN].
    //!
    //!   @value F_SETLKW
    //!
    //!     Identical to @[F_SETLK], but if a lock is held on the file, wait
    //!     for it to be released before returning. You are allowed to
    //!     return @[System.EINTR], to signal that the waiting has been
    //!     interrupted and must be restarted.
    //!
    //!   @value F_GETLK
    //!
    //!     Identical to @[F_SETLK], but do not actually aquire the lock if it
    //!     can be aquired.  If one or more incompatible locks would
    //!     prevent this lock being placed, then @[lock()] returns details
    //!     about one of these locks in the @expr{"type"@}, @expr{"whence"@},
    //!     @expr{start@}, and @expr{"len"@} fields of @[how] and sets
    //!     the @expr{"pid"@} field to be the PID of the process
    //!     holding that lock. Then return the mapping.
    //!
    //! @endint
    //!
    //! @param how
    //! @mapping how
    //!   @member int "owner"
    //!     Uid of the lock owner (if any).
    //!   @member int "type"
    //!     Type of operation. One of
    //!     @int
    //!       @value F_RDLCK
    //!         Acquire a read lock.
    //!       @value F_WRLCK
    //!         Acquite a write lock.
    //!       @value F_UNLCK
    //!         Release a lock.
    //!     @endint
    //!   @member int "whence"
    //!     How to interpret the @expr{"start"@} field. One of
    //!     @[Stdio.SEEK_CUR], @[Stdio.SEEK_SET] or @[Stdio.SEEK_END].
    //!   @member int "start"
    //!     Start offset of the file @[path] to lock.
    //!   @member int "len"
    //!     Number of bytes starting at @expr{"start"@} to lock.
    //!   @member int "pid"
    //!     Pid of the lock owner (if any).
    //! @endmapping
    optional mapping(string:int)|int lock( string path, int mode,
                                           mapping(string:int) how,
                                           mixed|void open_handle );

    //! Write unwritten data.
    optional int flush( string path, mixed|void open_handle );
}

//! @decl int run( Operations handler, array(string) args )
//! Start fuse. Args is as in argv in main(). This function will not
//! return.
//!
//! The first argument (@expr{argv[0]@}, program name) is used as
//! the filesystem name. The first non-flag argument after @expr{argv[0]@}
//! is used as the mountpoint.
//! Otherwise these arguments are supported:
//! @pre{
//!     -d                  enable debug output (implies -f)
//!     -f                  foreground operation
//!     -s                  disable multithreaded operation
//!     -r                  mount read only (equivalent to '-o ro')
//!     -o opt,[opt...]     mount options
//!     -h                  print help
//! @}
//!
//! Mount options:
//! @pre{
//!     rootmode=M             permissions of the '/' directory in the filesystem (octal)
//!     user_id=N              user of '/' (numeric)
//!     group_id=N             group of '/' (numeric)
//!     default_permissions    enable permission checking
//!
//!  By default FUSE doesn't check file access permissions, the
//!  filesystem is free to implement it's access policy or leave it to
//!  the underlying file access mechanism (e.g. in case of network
//!  filesystems).  This option enables permission checking,
//!  restricting access based on file mode.  It is usually useful
//!  together with the 'allow_other' mount option.
//!
//!     allow_other            allow access to other users
//!
//! This option overrides the security measure restricting file access
//! to the user mounting the filesystem.  This option is by default
//! only allowed to root, but this restriction can be removed with a
//! (userspace) configuration option (in fuse.ini).
//!
//!     large_read             issue large read requests (2.4 only)
//!     max_read=N             set maximum size of read requests (default 128K)
//!     hard_remove            immediate removal (don't hide files)
//!     debug                  enable debug output
//!     fsname=NAME            set filesystem name in mtab (overrides argv[0])
//!     auto_unmount           enable unmount on crash
//! @}
//!
//!   This function blocks until the filesystem is unmounted.
//!
//! @returns
//!   Returns a non-negative integer.
//!   @int
//!     @value 0
//!       Returns @expr{0@} (zero) on successfull mount followed by unmount.
//!     @value 1
//!       Invalid options in @[args].
//!     @value 2
//!       No mount poiunt specified.
//!     @value 3
//!       FUSE setup failed.
//!     @value 4
//!       Mounting failed.
//!     @value 5
//!       Failed to daemonize (detach from session).
//!     @value 6
//!       Failed to set up signal handlers.
//!     @value 7
//!       An error occurred during the life of the file system.
//!   @endint
//!
//! @note
//!   Prior to Pike 9.0 this function called @[exit()] with the return code.
//!
//! @note
//!   Only one call of this function may be active at a time.
//!
//! @seealso
//!   @[8.0::Fuse.run()]

// {
//     return ::run( handler, args );
// }
#endif
