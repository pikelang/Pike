#include "global.h"

#include "interpret.h"
#include "svalue.h"
#include "array.h"
#include "pike_macros.h"
#include "program.h"
#include "stralloc.h"
#include "object.h"
#include "pike_types.h"
#include "pike_threads.h"
#include "builtin_functions.h"
#include "config.h"

#if defined(HAVE_FFTW3_H) && defined(HAVE_LIBFFTW3)
#include <fftw3.h>
#define HAVE_RFFTW

typedef double fftw_real;
typedef fftw_plan rfftw_plan;
#define FFTW_REAL_TO_COMPLEX FFTW_R2HC
#define FFTW_COMPLEX_TO_REAL FFTW_HC2R
#define rfftw_destroy_plan fftw_destroy_plan
#define rfftw_one fftw_execute_r2r

/* FFTW 3 plans normally bind their buffers. Use the new-array interface
 * with unaligned buffers to retain FFTW 2's plan reuse semantics.
 * Measurement is done on scratch space, never on the caller's input.
 */
static rfftw_plan rfftw_create_plan(int n, fftw_r2r_kind direction,
                                  unsigned flags)
{
  double *in = calloc(n, sizeof(double));
  double *out = calloc(n, sizeof(double));
  fftw_plan plan;
  if (!in || !out) {
    free(in);
    free(out);
    Pike_error("Out of memory preparing FFT.\n");
  }
  plan = fftw_plan_r2r_1d(n, in, out, direction, flags | FFTW_UNALIGNED);
  free(in);
  free(out);
  return plan;
}
#elif defined(HAVE_FFTW_H) && defined(HAVE_LIBFFTW) && \
      defined(HAVE_RFFTW_H) && defined(HAVE_LIBRFFTW)
#include <fftw.h>
#include <rfftw.h>
#define HAVE_RFFTW
#endif

#ifdef HAVE_RFFTW

static fftw_real fft_input_number(struct svalue *value)
{
  switch (TYPEOF(*value)) {
  case PIKE_T_INT:
    return (fftw_real)value->u.integer;
  case PIKE_T_FLOAT:
    return (fftw_real)value->u.float_number;
  default:
    Pike_error("FFT input elements must be integers or floats.\n");
  }
}

DECLARATIONS

/*! @module Math
 */

/*! @module Transforms
 */

/*! @class FFT
 */

PIKECLASS FFT
{
  CVAR fftw_real *r_in;
  CVAR fftw_real *r_out;
  CVAR rfftw_plan r_cr_plan;
  CVAR rfftw_plan r_rc_plan;
  CVAR int r_cr_plan_size;
  CVAR int r_rc_plan_size;

  /*! @decl array(array(float)) rFFT(array(int|float) real_input)
   *!
   *!   Returns the FFT of the input array.
   *!   The input must be real and the output is complex.
   *!   The output consists of two arrays, containing the real and imaginary
   *!   parts of the complex frequency bins, respectively.
   *!
   *! @param real_input
   *!   The nonempty array of floats and/or ints to transform.
   *!
   *! @note
   *!   rIFFT(rFFT()) returns the input array scaled by n=sizeof(input array).
   *!   This is due to the nature of the DFT algorithm.
   *!
   *! @seealso
   *!   @[rIFFT()]
   */
  PIKEFUN array rFFT(array myarray)
    {
      struct array *a = myarray;
      int n = a->size;
      int i;

      if (!n) Pike_error("rFFT() requires a nonempty array.\n");

      free(THIS->r_in);
      THIS->r_in = NULL;
      THIS->r_in = xcalloc(n, sizeof(fftw_real));
      for (i = 0; i < n; i++)
        THIS->r_in[i] = fft_input_number(ITEM(a) + i);

      free(THIS->r_out);
      THIS->r_out = NULL;
      THIS->r_out = xcalloc(n, sizeof(fftw_real));

      if (THIS->r_rc_plan_size != n) {
        if (THIS->r_rc_plan) rfftw_destroy_plan(THIS->r_rc_plan);
        THIS->r_rc_plan = NULL;
        THIS->r_rc_plan_size = 0;
        THIS->r_rc_plan =
          rfftw_create_plan(n, FFTW_REAL_TO_COMPLEX, FFTW_ESTIMATE);
        if (!THIS->r_rc_plan) Pike_error("Failed to create FFT plan.\n");
        THIS->r_rc_plan_size = n;
      }
      rfftw_one(THIS->r_rc_plan, THIS->r_in, THIS->r_out);
      pop_n_elems(args);

      /* Expand halfcomplex storage to the full Hermitian spectrum. */
      check_stack((INT64)n + 2);
      for (i = 0; i < n; i++)
        push_float(THIS->r_out[i <= n/2 ? i : n-i]);
      f_aggregate(n);
      for (i = 0; i < n; i++) {
        if (!i || (!(n & 1) && i == n/2)) push_float(0.0);
        else if (i <= n/2) push_float(THIS->r_out[n-i]);
        else push_float(-THIS->r_out[i]);
      }
      f_aggregate(n);
      f_aggregate(2);

      free(THIS->r_out);
      THIS->r_out = NULL;
      free(THIS->r_in);
      THIS->r_in = NULL;
    }

  /*! @decl array(float) rIFFT(array(array(float)) input)
   *!
   *!   Returns the inverse FFT of the input array.
   *!   The input must be complex and guaranteed to generate a real output.
   *!
   *!   The input consists of two equally sized, nonempty arrays, containing
   *!   the real and imaginary parts of a Hermitian spectrum, respectively.
   *!
   *!   The output is an array of the real values for the iFFT.
   *! @param input
   *!   The real and imaginary arrays of floats and/or ints to transform.
   *!
   *! @note
   *!   rIFFT(rFFT()) returns the input array scaled by n=sizeof(input array).
   *!   This is due to the nature of the DFT algorithm.
   *!
   *! @seealso
   *!   @[rFFT()]
   */
  PIKEFUN array rIFFT(array myarray)
    {
      struct array *r, *p;
      int n, i;

      if (myarray->size != 2 ||
          TYPEOF(myarray->item[0]) != PIKE_T_ARRAY ||
          TYPEOF(myarray->item[1]) != PIKE_T_ARRAY ||
          myarray->item[0].u.array->size != myarray->item[1].u.array->size)
        Pike_error("rIFFT() requires two equally sized arrays.\n");
      r = myarray->item[0].u.array;
      p = myarray->item[1].u.array;
      n = r->size;
      if (!n) Pike_error("rIFFT() requires nonempty arrays.\n");

      free(THIS->r_in);
      THIS->r_in = NULL;
      THIS->r_in = xcalloc(n, sizeof(fftw_real));
      for (i = 0; i < n; i++) {
        fftw_real real = fft_input_number(ITEM(r) + i);
        fftw_real imag = fft_input_number(ITEM(p) + i);
        if (i <= n/2) THIS->r_in[i] = real;
        if (i && i <= (n-1)/2) THIS->r_in[n-i] = imag;
      }

      free(THIS->r_out);
      THIS->r_out = NULL;
      THIS->r_out = xcalloc(n, sizeof(fftw_real));
      if (THIS->r_cr_plan_size != n) {
        if (THIS->r_cr_plan) rfftw_destroy_plan(THIS->r_cr_plan);
        THIS->r_cr_plan = NULL;
        THIS->r_cr_plan_size = 0;
        THIS->r_cr_plan =
          rfftw_create_plan(n, FFTW_COMPLEX_TO_REAL, FFTW_ESTIMATE);
        if (!THIS->r_cr_plan)
          Pike_error("Failed to create inverse FFT plan.\n");
        THIS->r_cr_plan_size = n;
      }
      rfftw_one(THIS->r_cr_plan, THIS->r_in, THIS->r_out);
      pop_n_elems(args);
      check_stack(n);
      for (i = 0; i < n; i++) push_float(THIS->r_out[i]);
      f_aggregate(n);

      free(THIS->r_out);
      THIS->r_out = NULL;
      free(THIS->r_in);
      THIS->r_in = NULL;
    }

  /*! @decl void create(void|int n, void|int(0..1) exact)
   *!  Creates a new transform object. If n is specified, a plan
   *!  is created for transformations of n-size arrays.
   *!
   *! @param n
   *!   Size of the transform to be performed. Note that the transform object
   *!   will be initialized for this size, but if an array of different size is
   *!   sent to the object, it will be reinitialized. This can be used to gain
   *!   performance if all transforms will be of a given size.
   *!
   *! @param exact
   *!   If exact is 1, a "better" plan for the transform will be created. This
   *!   will take more time though. Use only if performance is needed.
   */
  PIKEFUN void create(void|int no, void|int(0..1) exact)
    type function(void|int, void|int(0..1):void);
    flags ID_PROTECTED;
  {
    int t = exact && exact->u.integer ? FFTW_MEASURE : FFTW_ESTIMATE;
    INT_TYPE n = no ? no->u.integer : 0;

    if (n < 0 || n > INT_MAX)
      Pike_error("FFT size must be between 0 and %d.\n", INT_MAX);
    if (THIS->r_rc_plan) rfftw_destroy_plan(THIS->r_rc_plan);
    if (THIS->r_cr_plan) rfftw_destroy_plan(THIS->r_cr_plan);
    THIS->r_rc_plan = THIS->r_cr_plan = NULL;
    THIS->r_rc_plan_size = THIS->r_cr_plan_size = 0;
    if (n > 0) {
      THIS->r_rc_plan = rfftw_create_plan(n, FFTW_REAL_TO_COMPLEX, t);
      if (!THIS->r_rc_plan) Pike_error("Failed to create FFT plan.\n");
      THIS->r_rc_plan_size = n;
      THIS->r_cr_plan = rfftw_create_plan(n, FFTW_COMPLEX_TO_REAL, t);
      if (!THIS->r_cr_plan) Pike_error("Failed to create inverse FFT plan.\n");
      THIS->r_cr_plan_size = n;
    }
  }

  INIT
    {
      THIS->r_in = THIS->r_out = NULL;
      THIS->r_rc_plan = THIS->r_cr_plan = NULL;
      THIS->r_rc_plan_size = THIS->r_cr_plan_size = 0;
    }

  EXIT
    gc_trivial;
    {
      if (THIS->r_cr_plan)
	rfftw_destroy_plan(THIS->r_cr_plan);
      if (THIS->r_rc_plan)
	rfftw_destroy_plan(THIS->r_rc_plan);
      free(THIS->r_out);
      free(THIS->r_in);
    }
}

/*! @endclass
 */

/*! @endmodule
 */

/*! @endmodule
 */

#endif /* HAVE_RFFTW */

void init_math_transforms(void)
{
#ifdef HAVE_RFFTW
  INIT
#endif /* HAVE_RFFTW */
}

void exit_math_transforms(void)
{
#ifdef HAVE_RFFTW
  EXIT
#endif /* HAVE_RFFTW */
}
