START_MARKER

cond_resolv( Image.AVIF.decode, [[

  test_do( add_constant("avif_enc",
    Image.AVIF.encode(Image.Image(8,8)->test(),
                      ([ "speed": Image.AVIF.SPEED_FASTEST ]))) )

  test_true( stringp(avif_enc) )

  test_true( objectp(Image.AVIF.decode(avif_enc)) )
  test_equal( Image.AVIF.decode(avif_enc)->xsize(), 8 )
  test_equal( Image.AVIF.decode(avif_enc)->ysize(), 8 )

  test_true( mappingp(Image.AVIF._decode(avif_enc)) )
  test_equal( Image.AVIF._decode(avif_enc)->format, "image/avif" )
  test_equal( Image.AVIF._decode(avif_enc)->xsize, 8 )
  test_equal( Image.AVIF._decode(avif_enc)->ysize, 8 )
  test_true( objectp(Image.AVIF._decode(avif_enc)->image) )

  test_do( add_constant("avif_enc") )

]])

END_MARKER
