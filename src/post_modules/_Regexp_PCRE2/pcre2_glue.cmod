#include "global.h"
#include "pcre2_machine.h"

#include "interpret.h"
#include "svalue.h"
#include "pike_error.h"
#include "stralloc.h"
#include "module_support.h"
#include "sprintf.h"

/*! @module Regexp
 */

/*! @module PCRE2
 */

DECLARATIONS

#ifdef HAVE_LIBPCRE2

#define PCRE2_CODE_UNIT_WIDTH 0
#include <pcre2.h>
#undef PCRE2_CODE_UNIT_WIDTH

/* Used with pcre2_config() when the return value is a string */
typedef char verstring24[24];
typedef char targetstring64[64];

static void push_pcre2_error_message(int errorcode)
{
  struct string_builder s;
  PCRE2_UCHAR32 buffer[256];
  int len=pcre2_get_error_message_32(errorcode, buffer, sizeof(buffer)-1);
  init_string_builder(&s, 2);
  if (len <= 0)
    string_builder_sprintf(&s, "Unknown error %d", errorcode);
  else
    string_builder_binary_strcat2(&s, (const p_wchar2 *)buffer, len);
  push_string(finish_string_builder(&s));
}

/*! @class CalloutBlock
 *!
 *! Context object passed to callout functions.
 *!
 *! @seealso
 *!   @[MatchContext.set_callout()]
 */
PIKECLASS CalloutBlock
{
  /* Note: pcre2_callout_block is assumed to be the same across all widths,
     just with the string pointers pointing to different width strings */
  CVAR pcre2_callout_block_8 *block;
  CVAR enum size_shift shift;

  /*! @decl int callout_number
   *!
   *! For a numerical callout, this contains the number of the callout
   *! in the range 0-255.  It is 255 for automatically generated callouts.
   */
  PIKEFUN int `callout_number()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->callout_number);
  }

  /*! @decl int capture_top
   *!
   *! Contains one more than the number of the highest captured substring
   *! so far.
   *!
   *! @seealso
   *!   @[offset_vector], @[capture_last]
   */
  PIKEFUN int `capture_top()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->capture_top);
  }

  /*! @decl int capture_last
   *!
   *! Contains the number of the most recently captured substring.
   *! The values of the fields @[capture_top] and @[capture_last] do not
   *! always differ by one; for example, when the callout in the pattern
   *! ((a)(b))(?C2) is taken, @[capture_last] is 1 but @[capture_top] is 4.
   *!
   *! @seealso
   *!   @[offset_vector], @[capture_top]
   */
  PIKEFUN int `capture_last()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->capture_last);
  }

  /*! @decl array(int) offset_vector
   *!
   *! The contents of offset_vector[2] to offset_vector[@[capture_top]*2-1]
   *! can be inspected in order to extract substrings that have been matched
   *! so far, in the same way as extracting substrings after a match has
   *! completed.  The values in offset_vector[0] and offset_vector[1] are
   *! always -1 because the match is by definition not complete.
   *! Substrings that have not been captured but whose numbers are less than
   *! capture_top also have both of their offset_vector slots set to -1.
   */
  PIKEFUN array(int) `offset_vector()
  {
    pcre2_callout_block_8 *block = THIS->block;
    PCRE2_SIZE i, len = 2*block->capture_top;
    PCRE2_SIZE *ovector = block->offset_vector;
    struct array *res;
    
    res=allocate_array(len);
    for (i=0; i<len; i++) {
      SET_SVAL(ITEM(res)[i], T_INT, NUMBER_NUMBER, integer,
               ovector[i]);
    }
    push_array(res);
  }

  /*! @decl string|zero mark
   *!
   *! Contains the name of the most recently passed (*MARK), (*PRUNE),
   *! or (*THEN) item in the match, or 0 if no such items have been passed.
   *! Instances of (*PRUNE) or (*THEN) without a name do not obliterate a
   *! previous (*MARK).
   */
  PIKEFUN string|zero `mark()
  {
    pcre2_callout_block_8 *block = THIS->block;

    if (block->mark)
      push_string(make_shared_pcharp(MKPCHARP(block->mark, THIS->shift)));
    else
      push_undefined();
  }

  /*! @decl string subject
   *!
   *! The string that was passed to the matching function
   */
  PIKEFUN string `subject()
  {
    pcre2_callout_block_8 *block = THIS->block;

    push_string(make_shared_wide_string(block->subject,
                                        block->subject_length, THIS->shift));
  }

  /*! @decl int start_match
   *!
   *! Normally the offset within the subject at which the current match
   *! attempt started.  However, if the escape sequence \K has been
   *! encountered, this value is changed to reflect the modified starting
   *! point.  If the pattern is not anchored, the callout function may
   *! be called several times from the same point in the pattern for different
   *! starting points in the subject.
   */
  PIKEFUN int `start_match()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->start_match);
  }

  /*! @decl int current_position
   *!
   *! The offset within the subject of the current match pointer.
   */
  PIKEFUN int `current_position()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->current_position);
  }

  /*! @decl int pattern_position
   *!
   *! The offset in the pattern string to the next item to be matched.
   */
  PIKEFUN int `pattern_position()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->pattern_position);
  }  
  
  /*! @decl int next_item_length
   *!
   *! The length of the next item to be processed in the pattern string.
   *! When the callout is at the end of the pattern, the length is zero.
   *! When the callout precedes an opening parenthesis, the length includes
   *! meta characters that follow the parenthesis.  For example, in a callout
   *! before an assertion such as (?=ab) the length is 3. For an alternation
   *! bar or a closing parenthesis, the length is one, unless a closing
   *! parenthesis is followed by a quantifier, in which case its length is
   *! included.  (This changed in release 10.23. In earlier releases,
   *! before an opening parenthesis the length was that of the entire group,
   *! and before an alternation bar or a closing parenthesis the length was
   *! zero.)
   */
  PIKEFUN int `next_item_length()
  {
    pcre2_callout_block_8 *block = THIS->block;
    push_int(block->next_item_length);
  }  

  /*! @decl int callout_string_offset
   *!
   *! The code unit offset to the start of the callout argument string within
   *! the original pattern string.
   */
  PIKEFUN int `callout_string_offset()
  {
    pcre2_callout_block_8 *block = THIS->block;
    if (block->version >= 1)
      push_int(block->callout_string_offset);
    else
      push_undefined();
  }

  /*! @decl string callout_string
   *!
   *! For callouts with string arguments, @[callout_number] is always zero,
   *! and this field contains the string that is contained within the pattern.
   */
  PIKEFUN string `callout_string()
  {
    pcre2_callout_block_8 *block = THIS->block;
    if (block->version >= 1 && block->callout_string != NULL)
      push_string(make_shared_wide_string(block->callout_string,
                                          block->callout_string_length,
                                          THIS->shift));
    else
      push_undefined();
  }

  /*! @decl int callout_flags
   *!
   *! This field is always zero when JIT is being used.  When JIT is not
   *! being used, the following bits may be set:
   *! @int
   *!   @value CALLOUT.STARTMATCH
   *!     This is set for the first callout after the start of matching for
   *!     each new starting position in the subject.
   *!   @value CALLOUT.BACKTRACK
   *!       This is set if there has been a matching backtrack since the
   *!       previous callout, or since the start of matching if this is the
   *!       first callout.
   *! @endint
   *! Both bits are set when a backtrack has caused a "bumpalong" to a new
   *! starting position in the subject.
   */
  PIKEFUN int `callout_flags()
  {
    /* 10.31 added both callout_flags and PCRE2_CALLOUT_STARTMATCH */
#ifdef PCRE2_CALLOUT_STARTMATCH
    pcre2_callout_block_8 *block = THIS->block;
    if (block->version >= 2)
      push_int(block->callout_flags);
    else
#endif
      push_undefined();
  }

  PIKEFUN void create()
    flags ID_PROTECTED;
  {
    Pike_error("The CalloutBlock type cannot be instantiated\n");
  }
}
/*! @endclass
 */

/*! @class MatchContext
 *!
 *! Object that can be provided to @[_pcre()->exec()] for extra context.
 */
PIKECLASS MatchContext
{
   CVAR pcre2_match_context_8 *ctx8;
   CVAR pcre2_match_context_16 *ctx16;
   CVAR pcre2_match_context_32 *ctx32;
   PIKEVAR function|void callout flags ID_PROTECTED|ID_PRIVATE;
   CVAR PCRE2_SIZE offset_limit;
   CVAR uint32_t heap_limit;
   CVAR uint32_t match_limit;
   CVAR uint32_t depth_limit;
   CVAR unsigned limits_set;

   static int callout_wrapper(void *block, void *context,
                              enum size_shift shift)
   {
     struct cq__Regexp_PCRE2_MatchContext_struct *ME = context;
     struct object *o = NULL;
     struct cq__Regexp_PCRE2_CalloutBlock_struct *cb;
     int rc;
     JMP_BUF recovery;
     struct svalue *save_sp = Pike_sp;

     if (SETJMP(recovery)) {
       UNSETJMP(recovery);
       call_handle_error();
       pop_n_elems(Pike_sp - save_sp);
       if (o)
         destruct_object(o, DESTRUCT_EXPLICIT);
       return PCRE2_ERROR_CALLOUT;
     }
     push_object(o = fast_clone_object(cq__Regexp_PCRE2_CalloutBlock_program));
     cb = (struct cq__Regexp_PCRE2_CalloutBlock_struct *)get_storage(o, cq__Regexp_PCRE2_CalloutBlock_program);
     cb->block = block;
     cb->shift = shift;
     apply_svalue(&ME->callout, 1);
     if (PIKE_TYPEOF(Pike_sp[-1]) == PIKE_T_INT)
       rc = Pike_sp[-1].u.integer;
     else
       rc = PCRE2_ERROR_CALLOUT;
     pop_n_elems(Pike_sp - save_sp);
     destruct_object(o, DESTRUCT_EXPLICIT);
     UNSETJMP(recovery);
     return rc;
   }

   static int callout_wrapper8(pcre2_callout_block_8 *block, void *context)
   {
     return callout_wrapper(block, context, eightbit);
   }
   
   static int callout_wrapper16(pcre2_callout_block_16 *block, void *context)
   {
     return callout_wrapper(block, context, sixteenbit);
   }

   static int callout_wrapper32(pcre2_callout_block_32 *block, void *context)
   {
     return callout_wrapper(block, context, thirtytwobit);
   }

   static void create_ctx_width(struct cq__Regexp_PCRE2_MatchContext_struct *that,
                                enum size_shift width)
   {
     void *result;
     int errorcode = 0;

     switch (width) {
     case eightbit:
       result=that->ctx8=pcre2_match_context_create_8(NULL);
       if (result) {
         if (PIKE_TYPEOF(that->callout))
           errorcode = pcre2_set_callout_8(result, callout_wrapper8, that);
         if ((that->limits_set & 1) && errorcode >= 0)
           errorcode = pcre2_set_offset_limit_8(result, that->offset_limit);
         if ((that->limits_set & 2) && errorcode >= 0)
           errorcode = pcre2_set_heap_limit_8(result, that->heap_limit);
         if ((that->limits_set & 4) && errorcode >= 0)
           errorcode = pcre2_set_match_limit_8(result, that->match_limit);
         if ((that->limits_set & 8) && errorcode >= 0)
           errorcode = pcre2_set_depth_limit_8(result, that->depth_limit);
       }
       break;
     case sixteenbit:
       result=that->ctx16=pcre2_match_context_create_16(NULL);
       if (result) {
         if (PIKE_TYPEOF(that->callout))
           errorcode = pcre2_set_callout_16(result, callout_wrapper16, that);
         if ((that->limits_set & 1) && errorcode >= 0)
           errorcode = pcre2_set_offset_limit_16(result, that->offset_limit);
         if ((that->limits_set & 2) && errorcode >= 0)
           errorcode = pcre2_set_heap_limit_16(result, that->heap_limit);
         if ((that->limits_set & 4) && errorcode >= 0)
           errorcode = pcre2_set_match_limit_16(result, that->match_limit);
         if ((that->limits_set & 8) && errorcode >= 0)
           errorcode = pcre2_set_depth_limit_16(result, that->depth_limit);
       }
       break;
     case thirtytwobit:
       result=that->ctx32=pcre2_match_context_create_32(NULL);
       if (result) {
         if (PIKE_TYPEOF(that->callout))
           errorcode = pcre2_set_callout_32(result, callout_wrapper32, that);
         if ((that->limits_set & 1) && errorcode >= 0)
           errorcode = pcre2_set_offset_limit_32(result, that->offset_limit);
         if ((that->limits_set & 2) && errorcode >= 0)
           errorcode = pcre2_set_heap_limit_32(result, that->heap_limit);
         if ((that->limits_set & 4) && errorcode >= 0)
           errorcode = pcre2_set_match_limit_32(result, that->match_limit);
         if ((that->limits_set & 8) && errorcode >= 0)
           errorcode = pcre2_set_depth_limit_32(result, that->depth_limit);
       }
       break;
     default:
       Pike_error("Invalid size_shift!\n");
     }

     if (!result) {
       Pike_error("No memory for match context\n");
     } else if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error creating match context: %pS\n",
                  Pike_sp[-1].u.string);
     }
   }

   /*! @decl void set_callout(function(CalloutBlock:int)|void callout)
    *!
    *! Set up a callout function to call at specified points during a
    *! matching operation.
    *!
    *! Within a regular expression, (?C<arg>) indicates a point at which the
    *! external function is to be called.  Different callout points can be
    *! identified by putting a number less than 256 after the letter C.
    *! The default value is zero.  Alternatively, the argument may be a
    *! delimited string.  The starting delimiter must be one of
    *! @tt{` ' " ^ % # $ {@} and the ending delimiter is the same as the
    *! start, except for @tt{{@}, where the ending delimiter is @tt{}@}.
    *! If the ending delimiter is needed within the string, it must
    *! be doubled.
    *!
    *! If the @[OPTION.AUTO_CALLOUT] bit is set when a pattern is compiled,
    *! callouts are automatically inserted, all with number 255, before each
    *! item in the pattern except for immediately before or after an explicit
    *! callout.
    *!
    *! @param callout
    *!   The function to call.  If the function return zero, matching
    *!   proceeds as normal.  If the value is greater than zero, matching
    *!   fails at the current point, but the testing of other matching
    *!   possibilities goes ahead, just as if a lookahead assertion had failed.
    *!   If the value is less than zero, the match is abandoned, and the
    *!   matching function returns the negative value.  In particular,
    *!   @[ERROR.NOMATCH] forces a standard "no match" failure.
    *!   The error number @[ERROR.CALLOUT] is reserved for use by callout
    *!   functions; it will never be used by PCRE2 itself.
    */
   PIKEFUN void set_callout(function(CalloutBlock:int)|void callout)
   {
     int errorcode = 0;
     if (callout)
       assign_svalue(&THIS->callout, callout);
     else {
       free_svalue(&THIS->callout);
       clear_svalues_undefined(&THIS->callout, 1);
     }

     if (THIS->ctx8 && errorcode >= 0)
       errorcode = pcre2_set_callout_8(THIS->ctx8,
                                       (callout? callout_wrapper8 : NULL),
                                       THIS);
     if (THIS->ctx16 && errorcode >= 0)
       errorcode = pcre2_set_callout_16(THIS->ctx16,
                                        (callout? callout_wrapper16 : NULL),
                                        THIS);
     if (THIS->ctx32 && errorcode >= 0)
       errorcode = pcre2_set_callout_32(THIS->ctx32,
                                        (callout? callout_wrapper32 : NULL),
                                        THIS);
     if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_set_callout: %pS\n",
                  Pike_sp[-1].u.string);
     }
     pop_stack();
   }

   /*! @decl void set_offset_limit(int value)
    *!
    *! Limit how far an unanchored search can advance in the subject string.
    *! The default value is -1.  The @[_pcre()->exec()] function returns
    *! @[ERROR.NOMATCH] if a match with a starting point before or at the
    *! given offset is not found.
    */   
   PIKEFUN void set_offset_limit(int value)
   {
     int errorcode = 0;
     PCRE2_SIZE limit = (value < 0? PCRE2_UNSET : (PCRE2_SIZE)value);
     THIS->offset_limit = limit;
     THIS->limits_set |= 1u;
     if (THIS->ctx8 && errorcode >= 0)
       errorcode = pcre2_set_offset_limit_8(THIS->ctx8, limit);
     if (THIS->ctx16 && errorcode >= 0)
       errorcode = pcre2_set_offset_limit_16(THIS->ctx16, limit);
     if (THIS->ctx32 && errorcode >= 0)
       errorcode = pcre2_set_offset_limit_32(THIS->ctx32, limit);
     if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_set_offset_limit: %pS\n",
                  Pike_sp[-1].u.string);
     }
     pop_stack();
   }

   /*! @decl void set_heap_limit(int value)
    *!
    *! Specify, in units of kibibytes (1024 bytes), the maximum amount
    *! of heap memory that pcre2_match() may use to hold backtracking
    *! information when running an interpretive match.
    */   
   PIKEFUN void set_heap_limit(int value)
   {
     int errorcode = 0;
     THIS->heap_limit = value;
     THIS->limits_set |= 2u;
     if (THIS->ctx8 && errorcode >= 0)
       errorcode = pcre2_set_heap_limit_8(THIS->ctx8, value);
     if (THIS->ctx16 && errorcode >= 0)
       errorcode = pcre2_set_heap_limit_16(THIS->ctx16, value);
     if (THIS->ctx32 && errorcode >= 0)
       errorcode = pcre2_set_heap_limit_32(THIS->ctx32, value);
     if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_set_heap_limit: %pS\n",
                  Pike_sp[-1].u.string);
     }
     pop_stack();
   }
   
   /*! @decl void set_match_limit(int value)
    *!
    *! The match_limit parameter provides a means of preventing PCRE2
    *! from using up too many computing resources when processing patterns
    *! that are not going to match, but which have a very large number of
    *! possibilities in their search trees. The classic example is a pattern
    *! that uses nested unlimited repeats.
    *!
    *! There is an internal counter in pcre2_match() that is incremented each
    *! time round its main matching loop.  If this value reaches the match
    *! limit, pcre2_match() returns the negative value @[ERROR.MATCHLIMIT].
    *! This has the effect of limiting the amount of backtracking that can take
    *! place.  For patterns that are not anchored, the count restarts from zero
    *! for each position in the subject string.
    *!
    *! When pcre2_match() is called with a pattern that was successfully
    *! processed by pcre2_jit_compile(), the way in which matching is executed
    *! is entirely different.  However, there is still the possibility of
    *! runaway matching that goes on for a very long time, and so the
    *! match_limit value is also used in this case (but in a different way)
    *! to limit how long the matching can continue.
    */   
   PIKEFUN void set_match_limit(int value)
   {
     int errorcode = 0;
     THIS->match_limit = value;
     THIS->limits_set |= 4u;
     if (THIS->ctx8 && errorcode >= 0)
       errorcode = pcre2_set_match_limit_8(THIS->ctx8, value);
     if (THIS->ctx16 && errorcode >= 0)
       errorcode = pcre2_set_match_limit_16(THIS->ctx16, value);
     if (THIS->ctx32 && errorcode >= 0)
       errorcode = pcre2_set_match_limit_32(THIS->ctx32, value);
     if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_set_match_limit: %pS\n",
                  Pike_sp[-1].u.string);
     }
     pop_stack();
   }

   /*! @decl void set_depth_limit(int value)
    *!
    *! Limit the depth of nested backtracking in pcre2_match().
    *! Each time a nested backtracking point is passed, a new memory frame is
    *! used to remember the state of matching at that point.  Thus, this
    *! parameter indirectly limits the amount of memory that is used in
    *! a match. However, because the size of each memory frame depends on
    *! the number of capturing  parentheses, the actual memory limit varies
    *! from pattern to pattern.  This limit was more useful in versions
    *! before 10.30, where function recursion was used for backtracking.
    */   
   PIKEFUN void set_depth_limit(int value)
   {
     int errorcode = 0;
     THIS->depth_limit = value;
     THIS->limits_set |= 8u;
     if (THIS->ctx8 && errorcode >= 0)
       errorcode = pcre2_set_depth_limit_8(THIS->ctx8, value);
     if (THIS->ctx16 && errorcode >= 0)
       errorcode = pcre2_set_depth_limit_16(THIS->ctx16, value);
     if (THIS->ctx32 && errorcode >= 0)
       errorcode = pcre2_set_depth_limit_32(THIS->ctx32, value);
     if (errorcode < 0) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_set_depth_limit: %pS\n",
                  Pike_sp[-1].u.string);
     }
     pop_stack();
   }

#ifdef PIKE_NULL_IS_SPECIAL
   INIT
   {
     THIS->ctx8=NULL;
     THIS->ctx16=NULL;
     THIS->ctx32=NULL;
   }
#endif

   EXIT
     gc_trivial;
   { 
     if (THIS->ctx8) {
       pcre2_match_context_free_8(THIS->ctx8);
       THIS->ctx8 = NULL;
     }
     if (THIS->ctx16) {
       pcre2_match_context_free_16(THIS->ctx16);
       THIS->ctx16 = NULL;
     }
     if (THIS->ctx32) {
       pcre2_match_context_free_32(THIS->ctx32);
       THIS->ctx32 = NULL;
     }
   }

}
/*! @endclass
 */


/*** _pcre the regexp object ***********************************/

/*! @class _pcre
 */

PIKECLASS _pcre
{
   CVAR pcre2_code_8 *re8;
   CVAR pcre2_code_16 *re16;
   CVAR pcre2_code_32 *re32;
   CVAR pcre2_match_data_8 *md8;
   CVAR pcre2_match_data_16 *md16;
   CVAR pcre2_match_data_32 *md32;
   CVAR uint32_t options;
   CVAR int jit;
   PIKEVAR string pattern;

   static void create_re_width(struct cq__Regexp_PCRE2_cq__pcre_struct *that,
                               enum size_shift width)
   {
     struct pike_string *pattern = that->pattern;
     struct string_builder s;
     ONERROR error;
     void *result;
     int errorcode;
     PCRE2_SIZE erroffset;
   
     if (width != pattern->size_shift) {
       init_string_builder(&s, width);
       SET_ONERROR(error, free_string_builder, &s);
       string_builder_shared_strcat(&s, that->pattern);
       pattern = s.s;
       if (width != pattern->size_shift)
         Pike_error("Failed to widen string\n");
     } else
       error.func = NULL;
   
     switch (width) {
     case eightbit:
       result=THIS->re8=pcre2_compile_8(
         STR0(pattern),
         pattern->len,
         that->options,
         &errorcode,&erroffset,
         NULL /* table */ );
       if (result)
         errorcode = (THIS->jit ?
                      pcre2_jit_compile_8(result, PCRE2_JIT_COMPLETE) : 0);
       break;
     case sixteenbit:
       result=THIS->re16=pcre2_compile_16(
         STR1(pattern),
         pattern->len,
         that->options,
         &errorcode,&erroffset,
         NULL /* table */ );
       if (result)
         errorcode = (THIS->jit ?
                      pcre2_jit_compile_16(result, PCRE2_JIT_COMPLETE) : 0);
       break;
     case thirtytwobit:
       result=THIS->re32=pcre2_compile_32(
         (PCRE2_SPTR32)STR2(pattern),
         pattern->len,
         that->options,
         &errorcode,&erroffset,
         NULL /* table */ );
       if (result)
         errorcode = (THIS->jit ?
                      pcre2_jit_compile_32(result, PCRE2_JIT_COMPLETE) : 0);
       break;
     default:
       Pike_error("Invalid size_shift!\n");
     }
   
     if (!result) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre_compile [%d]: %pS\n",
                  (int)erroffset,Pike_sp[-1].u.string);
     } else if (errorcode < 0 && errorcode != PCRE2_ERROR_JIT_BADOPTION
#ifdef PCRE2_ERROR_JIT_UNSUPPORTED
                && errorcode != PCRE2_ERROR_JIT_UNSUPPORTED
#endif
                ) {
       push_pcre2_error_message(errorcode);
       Pike_error("error calling pcre2_jit_compile: %pS\n",
                  Pike_sp[-1].u.string);
     }

     if (error.func)
       CALL_AND_UNSET_ONERROR (error);
   }

   /*! @decl void create(string pattern, void|int options, void|object table)
    *!
    *! The option bits are:
    *! @int
    *!   @value  OPTION.ALLOW_EMPTY_CLASS
    *!     Treat a closing square bracket that immediately follows an opening
    *!     one as a class with no characters
    *!   @value  OPTION.ALT_BSUX
    *!     Alter handling of \u, \U, and \x to closer match ECMAscript
    *!   @value  OPTION.ANCHORED
    *!     Force pattern anchoring
    *!   @value  OPTION.AUTO_CALLOUT
    *!     Automatically inserts callout items, all with number 255, before
    *!     each pattern item, except immediately before or after an explicit
    *!     callout in the pattern
    *!   @value  OPTION.CASELESS
    *!     Do caseless matching
    *!   @value  OPTION.DOLLAR_ENDONLY
    *!     $ not to match newline at end
    *!   @value  OPTION.DOTALL
    *!     . matches anything including NL
    *!   @value  OPTION.DUPNAMES
    *!     Names used to identify capture groups need not be unique
    *!   @value  OPTION.ENDANCHORED
    *!     The end of any pattern match must be right at the end of the
    *!     string being searched
    *!   @value  OPTION.EXTENDED
    *!     Ignore whitespace and # comments
    *!   @value  OPTION.FIRSTLINE
    *!     The start of an unanchored pattern match must be before or at the
    *!     first newline in the subject string following the start of matching
    *!   @value  OPTION.MATCH_UNSET_BACKREF
    *!     A backreference to an unset capture group matches an empty string
    *!   @value  OPTION.MULTILINE
    *!     ^ and $ match newlines within data
    *!   @value  OPTION.NEVER_UCP
    *!     Locks out the use of Unicode properties
    *!   @value  OPTION.NEVER_UTF
    *!     Locks out interpretation of the pattern as UTF-8, UTF-16, or UTF-32 
    *!   @value  OPTION.NO_AUTO_CAPTURE
    *!     Disable numbered capturing parentheses (named ones available)
    *!   @value  OPTION.NO_AUTO_POSSESS
    *!     Disable "auto-possessification"
    *!   @value  OPTION.NO_DOTSTAR_ANCHOR
    *!     Disables an optimization that is applied when .* is the first
    *!     significant item in a top-level branch of a pattern, and all the
    *!     other branches also start with .* or with \A or \G or ^
    *!   @value  OPTION.NO_START_OPTIMIZE
    *!     Disable start-up optimizations
    *!   @value  OPTION.NO_UTF_CHECK
    *!     Disable checks for UTF validity
    *!   @value  OPTION.UCP
    *!     Force the use of Unicode properties 
    *!   @value  OPTION.UNGREEDY
    *!     Invert greediness of quantifiers
    *!   @value  OPTION.UTF
    *!     Regard both the pattern and the subject strings that are
    *!     subsequently processed as strings of UTF characters instead of
    *!     single-code-unit strings
    *!   @value  OPTION.NEVER_BACKSLASH_C
    *!     Ĺock out the use of \C in the pattern that is being compiled
    *!   @value  OPTION.ALT_CIRCUMFLEX
    *!     A multiline circumflex also matches after a terminating newline
    *!   @value  OPTION.ALT_VERBNAMES
    *!     Normal backslash processing is applied to verb names and only an
    *!     unescaped closing parenthesis terminates the name
    *!   @value  OPTION.EXTENDED_MORE
    *!     Like @[OPTION.EXTENDED] but, in addition, unescaped space and
    *!     horizontal tab characters are ignored inside a character class
    *!   @value  OPTION.LITERAL
    *!     All meta-characters in the pattern are disabled, and it is treated
    *!     as a literal string
    *!   @value  OPTION.MATCH_INVALID_UTF
    *!     Enables support for matching in subject strings that contain
    *!     invalid UTF sequences
    *!   @value  OPTION.ALT_EXTENDED_CLASS
    *!     Alters the parsing of character classes to follow the extended
    *!     syntax described by Unicode UTS#18
    *! @endint
    */

   PIKEFUN void create(string pattern,
                       void|int options,
                       void|object table)
     flags ID_PROTECTED;
   {
     if (THIS->pattern) { free_string(THIS->pattern); THIS->pattern=NULL; }
     THIS->pattern = pattern;
     add_ref(pattern);

     if (THIS->md8) {
       pcre2_match_data_free_8(THIS->md8);
       THIS->md8 = NULL;
     }
     if (THIS->md16) {
       pcre2_match_data_free_16(THIS->md16);
       THIS->md16 = NULL;
     }
     if (THIS->md32) {
       pcre2_match_data_free_32(THIS->md32);
       THIS->md32 = NULL;
     }
     if (THIS->re8) {
       pcre2_code_free_8(THIS->re8);
       THIS->re8 = NULL;
     }
     if (THIS->re16) {
       pcre2_code_free_16(THIS->re16);
       THIS->re16 = NULL;
     }
     if (THIS->re32) {
       pcre2_code_free_32(THIS->re32);
       THIS->re32 = NULL;
     }

     THIS->options =
       options && TYPEOF(*options) == PIKE_T_INT ? options->u.integer : 0;
     
     if (!(THIS->options &
           (PCRE2_UTF | PCRE2_NEVER_UCP
#ifdef PCRE2_MATCH_INVALID_UTF
            | PCRE2_MATCH_INVALID_UTF
#endif
            )))
       THIS->options |= PCRE2_UCP | PCRE2_NEVER_UTF;

     THIS->jit = 0;

     create_re_width(THIS, pattern->size_shift);
   }

   /*! @decl object study()
    *!
    *!  Request JIT compilation
    */

   PIKEFUN object study()
   {
     int errorcode = 0;
     if (!THIS->jit) {
       if (errorcode >= 0 && THIS->re8)
         errorcode = pcre2_jit_compile_8(THIS->re8, PCRE2_JIT_COMPLETE);
       if (errorcode >= 0 && THIS->re16)
         errorcode = pcre2_jit_compile_16(THIS->re16, PCRE2_JIT_COMPLETE);
       if (errorcode >= 0 && THIS->re32)
         errorcode = pcre2_jit_compile_32(THIS->re32, PCRE2_JIT_COMPLETE);
       if (errorcode == PCRE2_ERROR_JIT_BADOPTION
#ifdef PCRE2_ERROR_JIT_UNSUPPORTED
           || errorcode == PCRE2_ERROR_JIT_UNSUPPORTED
#endif
           )
         ; // JIT not available
       else if (errorcode < 0) {
         push_pcre2_error_message(errorcode);
         Pike_error("error calling pcre2_jit_compile: %pS\n",
                    Pike_sp[-1].u.string);
       } else
         THIS->jit = 1;
     }
     RETURN this_object();
   }

   /*! @decl protected string _sprintf(int c, mapping flags)
    */
   PIKEFUN string _sprintf(int c, mapping flags)
     flags ID_PROTECTED;
   {
     switch(c)
     {
     default:
       push_undefined();
       return;

     case 'O':
       push_static_text ("%t(%O)");
       ref_push_object(Pike_fp->current_object);
       if (THIS->pattern)
         ref_push_string(THIS->pattern);
       else
         push_undefined();
       f_sprintf(3);
       return;

     case 's':
       if (THIS->pattern)
         ref_push_string(THIS->pattern);
       else
         push_undefined();
       return;

     case 't':
       push_static_text("Regexp.PCRE2._pcre");
       return;
     }
   }

/*! @decl int|array exec(string subject,void|int startoffset,	@
 *!                      MatchContext|void context)
 *!     Matches the regexp against @[subject], starting at
 *!     @[startoffset] if it is given.
 *!
 *!     If @[context] is given, it is a @[MatchContext] object providing
 *!     additional context for the match, such as a callout function.
 *!
 *!     If the match is successful, the return value is an array that
 *!     holds the offsets of all matches:
 *!
 *!     Elements 0 and 1 have the start and end offsets, respectively,
 *!     of the match for the whole regexp. The start offset is
 *!     inclusive while the end is exclusive, i.e. the matching string
 *!     is @expr{@[subject][res[0]..res[1]-1]@}.
 *!
 *!     Elements 2 and 3 have the offsets of the first capturing
 *!     submatch (if any) in the same way, elements 4 and 5 are for
 *!     the second capturing submatch, etc. If a submatch didn't match
 *!     anything, the corresponding elements are set to -1. If a
 *!     submatch has matched successfully several times, the offsets
 *!     of the last match are returned.
 *!
 *!     The returned array is always of length 2*n + 1, where n is the
 *!     total number of capturing submatches in the regexp.
 *!
 *!     If there is an error, an integer error code is returned:
 *!
 *!  @int
 *!     @value ERROR.NOMATCH
 *!
 *!   The subject string did not match the pattern.
 *!
 *!     @value ERROR.NULL
 *!
 *!   Either the code, subject, or match_data argument was passed as NULL.
 *!
 *!     @value ERROR.BADOPTION
 *!
 *!   An unrecognized bit was set in the options argument.
 *!
 *!     @value ERROR.BADMAGIC
 *!
 *!   PCRE2 stores a 4-byte "magic number" at the start of the compiled
 *!   code, to catch the case when it is passed a junk pointer. This
 *!   is the error it gives when the magic number isn't present.
 *!
 *!     @value ERROR.NOMEMORY
 *!
 *!   Heap memory is used to remember backtracking points. This error is given
 *!   when the memory allocation function (default or custom) fails. Note that
 *!   a different error, @[ERROR.HEAPLIMIT], is given if the amount of memory
 *!   needed exceeds the heap limit.
 *!
 *!     @value ERROR.NOSUBSTRING
 *!
 *!   This error is used by the pcre_copy_substring(),
 *!   pcre_get_substring(), and pcre_get_substring_list() functions
 *!   (see below). It is never returned by pcre_exec().
 *!
 *!     @value ERROR.MATCHLIMIT
 *!
 *!   The recursion and backtracking limit, as specified by the
 *!   match_limit field in a pcre_extra structure (or defaulted) was
 *!   reached. See the description above.
 *!
 *!     @value ERROR.HEAPLIMIT
 *!
 *!   The heap limit was reached.
 *!
 *!     @value ERROR.CALLOUT
 *!
 *!   This error is never generated by pcre_exec() itself. It is
 *!   provided for use by callout functions that want to yield a
 *!   distinctive error code. See the pcrecallout documentation for
 *!   details.
 *! @endint
 */

   PIKEFUN int|array(int) exec(string subject,
                               void|int startoffset,
                               MatchContext|void context)
   {
     struct array *res;

     PCRE2_SIZE off=0;
     uint32_t opts=0;

     if (!THIS->pattern)
       Pike_error("need to initialize before exec() is called\n");

     if (startoffset) {
       INT64 o;
       if (!int64_from_svalue(&o, startoffset))
         Pike_error("int expected\n");
       off = o;
     }

     if (off > (PCRE2_SIZE)subject->len) {
       /* PCRE2 returns PCRE2_ERROR_BADOFFSET in this case,
          but the testsuite expects NOMATCH (-1)... */
       push_int (PCRE2_ERROR_NOMATCH);
     }

     else {
       int rc;
       uint32_t len;
       PCRE2_SIZE *ovector = NULL;
       struct pike_string *sub = subject;
       struct string_builder s;
       ONERROR error;
       struct cq__Regexp_PCRE2_MatchContext_struct *match_context = NULL;
       
       if (sub->size_shift < THIS->pattern->size_shift) {
         /* Need to widen subject */
         init_string_builder(&s, THIS->pattern->size_shift);
         SET_ONERROR(error, free_string_builder, &s);
         string_builder_shared_strcat(&s, subject);
         sub = s.s;
         if (sub->size_shift < THIS->pattern->size_shift)
           Pike_error("Failed to widen string\n");
       } else
         error.func = NULL;

       if (context != NULL) {
         if ((match_context =
              get_storage(context, cq__Regexp_PCRE2_MatchContext_program))
             == NULL)
           SIMPLE_ARG_TYPE_ERROR("exec", 3, "Regexp.PCRE2.MatchContext");
       }
       
       switch(sub->size_shift) {
       case eightbit:
         if (!THIS->re8)
           create_re_width(THIS, eightbit);
         if (!THIS->md8)
           THIS->md8 = pcre2_match_data_create_from_pattern_8(THIS->re8, NULL);
         if (match_context && !match_context->ctx8)
           create_ctx_width(match_context, eightbit);
         rc=pcre2_match_8(THIS->re8,
                          STR0(sub),sub->len,
                          off,opts,
                          THIS->md8,
                          (match_context? match_context->ctx8 : NULL));
         if (rc>=0) {
           ovector = pcre2_get_ovector_pointer_8(THIS->md8);
           len = pcre2_get_ovector_count_8(THIS->md8) * 2;
         }
         break;
       case sixteenbit:
         if (!THIS->re16)
           create_re_width(THIS, sixteenbit);
         if (!THIS->md16)
           THIS->md16 = pcre2_match_data_create_from_pattern_16(THIS->re16, NULL);
         if (match_context && !match_context->ctx16)
           create_ctx_width(match_context, sixteenbit);
         rc=pcre2_match_16(THIS->re16,
                           STR1(sub),sub->len,
                           off,opts,
                           THIS->md16,
                           (match_context? match_context->ctx16 : NULL));
         if (rc>=0) {
           ovector = pcre2_get_ovector_pointer_16(THIS->md16);
           len = pcre2_get_ovector_count_16(THIS->md16) * 2;
         }
         break;
       case thirtytwobit:
         if (!THIS->re32)
           create_re_width(THIS, thirtytwobit);
         if (!THIS->md32)
           THIS->md32 = pcre2_match_data_create_from_pattern_32(THIS->re32, NULL);
         if (match_context && !match_context->ctx32)
           create_ctx_width(match_context, thirtytwobit);
         rc=pcre2_match_32(THIS->re32,
                           (PCRE2_SPTR32)STR2(sub),sub->len,
                           off,opts,
                           THIS->md32,
                           (match_context? match_context->ctx32 : NULL));
         if (rc>=0) {
           ovector = pcre2_get_ovector_pointer_32(THIS->md32);
           len = pcre2_get_ovector_count_32(THIS->md32) * 2;
         }
         break;
       default:
         Pike_error("Invalid size_shift!\n");
       }

       if (rc<0)
       {
         push_int(rc);
       }
       else
       {
         uint32_t i, urc=(uint32_t)rc;
         urc*=2;
         if (urc > len)
           urc = len;
         res=allocate_array(len);
         for (i=0; i<urc; i++)
         {
           SET_SVAL(ITEM(res)[i], T_INT, NUMBER_NUMBER, integer,
                    ovector[i]);
         }
         for (; i < len; i++) {
           SET_SVAL(ITEM(res)[i], T_INT, NUMBER_NUMBER, integer, -1);
         }
         push_array(res);
       }
       if (error.func)
         CALL_AND_UNSET_ONERROR (error);
     }
   }

/* init and exit */

#ifdef PIKE_NULL_IS_SPECIAL
   INIT
   {
     THIS->re8=NULL;
     THIS->re16=NULL;
     THIS->re32=NULL;
     THIS->md8=NULL;
     THIS->md16=NULL;
     THIS->md32=NULL;
     THIS->pattern=NULL;
   }
#endif

   EXIT
     gc_trivial;
   {
     if (THIS->md8) {
       pcre2_match_data_free_8(THIS->md8);
       THIS->md8 = NULL;
     }
     if (THIS->md16) {
       pcre2_match_data_free_16(THIS->md16);
       THIS->md16 = NULL;
     }
     if (THIS->md32) {
       pcre2_match_data_free_32(THIS->md32);
       THIS->md32 = NULL;
     }
     if (THIS->re8) {
       pcre2_code_free_8(THIS->re8);
       THIS->re8 = NULL;
     }
     if (THIS->re16) {
       pcre2_code_free_16(THIS->re16);
       THIS->re16 = NULL;
     }
     if (THIS->re32) {
       pcre2_code_free_32(THIS->re32);
       THIS->re32 = NULL;
     }
   }

}
/*! @endclass
 */

/*! @decl array(string) split_subject(string subject, @
 *!                        array(int) previous_result)
 *! Convenience function that
 *! splits a subject string on the result from @[_pcre()->exec()]
 *!
 *! equal to
 *! map(previous_result/2,
 *!     lambda(array v) { return subject[v[0]..v[1]-1]; })
 */

PIKEFUN array(string) split_subject(string subject,array(int) previous_result)
{
  int i,j;
  int sz=previous_result->size/2;
  struct array *res;

  for (i=0; i<sz*2; i++)
    if (TYPEOF(ITEM(previous_result)[i]) != T_INT)
      SIMPLE_ARG_TYPE_ERROR("split_subject",2,"array(int)");

  res=allocate_array(sz);
  for (i=j=0; j<sz; i+=2,j++)
  {
    INT_TYPE start = ITEM(previous_result)[i].u.integer;
    INT_TYPE end = ITEM(previous_result)[i+1].u.integer;
    if (start >= 0 && end >= start) {
      SET_SVAL(ITEM(res)[j], T_STRING, 0, string,
               string_slice(subject, start, end - start));
    }
  }

   RETURN res;
}

#endif /* HAVE_LIBPCRE2 */

/*** module init & exit & stuff *****************************************/

PIKE_MODULE_EXIT
{
  EXIT
}

PIKE_MODULE_INIT
{
#ifdef HAVE_LIBPCRE2

/*! @decl constant buildconfig_NEWLINE
 *!	(from the pcre2api man-page)
 *!     The output is an integer whose value specifies the default
 *!     character sequence that is recognized as meaning "newline".
 *!     The values are:
 *!     @int
 *!        @value NEWLINE.CR
 *!          Carriage return (CR)
 *!        @value NEWLINE.LF
 *!          Linefeed (LF)
 *!        @value NEWLINE.CRLF
 *!          Carriage return, linefeed (CRLF)
 *!        @value NEWLINE.ANY
 *!          Any Unicode line ending
 *!        @value NEWLINE.ANYCRLF
 *!          Any of CR, LF, or CRLF
 *!        @value NEWLINE.NUL
 *!          The NUL character (binary zero)
 *!     @endint
 *!     The default should normally correspond to the standard sequence
 *!     for your operating system.
 *!
 *! @decl constant buildconfig_LINKSIZE
 *!	(from the pcre2api man-page)
 *!     The output is an integer that contains the number of bytes the
 *!     library was instructed to use for internal linkage in compiled regular
 *!     expressions.  When PCRE2 is configured, the value can be set to 2, 3,
 *!     or 4, with the default being 2 for most libraries.
 *!
 *!     The actual number of bytes used depends on the size of the code units
 *!     that the library supports and can be higher.
 *!
 *!     The default value of 2 for the 8-bit and 16-bit libraries is
 *!     sufficient for all but the most massive patterns, since it allows the
 *!     size of the compiled pattern to be up to 65535 code units.  Larger
 *!     values allow larger regular expressions to be compiled by those two
 *!     libraries, but at the expense of slower matching.
 *!
 *! @decl constant buildconfig_MATCHLIMIT
 *!     (from the pcre2api man-page)
 *!	The output is an integer that gives the default match limit for
 *!     pcre2_match().
 *!
 *! @decl constant buildconfig_HEAPLIMIT
 *!     (from the pcre2api man-page)
 *!     The output is an integer that gives, in kibibytes, the default
 *!     limit for the amount of heap memory used by @[match()].
 *!
 *! @decl constant buildconfig_JIT
 *!     (from the pcre2api man-page)
 *!     The output is an integer that is set to one if support for
 *!     just-in-time compiling is included in the library; otherwise it is set
 *!     to zero. Note that having the support in the library does not guarantee
 *!     that JIT will be used for any given match, and neither does it
 *!     guarantee that JIT will actually be able to function, because it may
 *!     not be able to allocate executable memory in some environments.
 *!
 *! @decl constant buildconfig_UNICODE_VERSION
 *!     (from the pcre2api man-page)
 *!     If PCRE2 has been compiled without Unicode support, the buffer is
 *!     filled with the text "Unicode not supported". Otherwise, the Unicode
 *!     version string (for example, "8.0.0") is inserted.
 *!
 *! @decl constant buildconfig_VERSION
 *!     (from the pcre2api man-page)
 *!     The buffer is filled with the PCRE2 version string.
 *!
 *! @decl optional constant buildconfig_JITTARGET
 *!     (from the pcre2api man-page)
 *!     The buffer is filled with a string that contains the name of the
 *!     architecture for which the JIT compiler is configured, for example
 *!     "x86 32bit (little endian + unaligned)".
 *!     If JIT support is not available, this constant does not exist.
 */

#define FIGURE_BUILD_TIME_OPTION(X,T,CT)				\
  do									\
  {									\
    T outcome;                                                          \
    if (pcre2_config_8(PCRE2_CONFIG_##X,&outcome)>=0)			\
      add_##CT##_constant("buildconfig_"#X,outcome,0);                  \
  }									\
  while (0)

#ifdef PCRE2_CONFIG_NEWLINE
  FIGURE_BUILD_TIME_OPTION(NEWLINE,uint32_t,integer);
#endif
#ifdef PCRE2_CONFIG_LINKSIZE
  FIGURE_BUILD_TIME_OPTION(LINKSIZE,uint32_t,integer);
#endif
#ifdef PCRE2_CONFIG_MATCHLIMIT
  FIGURE_BUILD_TIME_OPTION(MATCHLIMIT,uint32_t,integer);
#endif
#ifdef PCRE2_CONFIG_HEAPLIMIT
  FIGURE_BUILD_TIME_OPTION(HEAPLIMIT,uint32_t,integer);
#endif
#ifdef PCRE2_CONFIG_JIT
  FIGURE_BUILD_TIME_OPTION(JIT,uint32_t,integer);
#endif
#ifdef PCRE2_CONFIG_UNICODE_VERSION
  FIGURE_BUILD_TIME_OPTION(UNICODE_VERSION,verstring24,string);
#endif
#ifdef PCRE2_CONFIG_VERSION
  FIGURE_BUILD_TIME_OPTION(VERSION,verstring24,string);
#endif
#ifdef PCRE2_CONFIG_JITTARGET
  FIGURE_BUILD_TIME_OPTION(JITTARGET,targetstring64,string);
#endif

  /*! @module NEWLINE
   *!  contains all newline constants
   */

  start_new_program();

  /*! @decl constant CR
   *!   Newline is carriage return (CR)
   */
  add_integer_constant("CR",PCRE2_NEWLINE_CR,0);
  /*! @decl constant LF
   *!   Newline is linefeed (LF)
   */
  add_integer_constant("LF",PCRE2_NEWLINE_LF,0);
  /*! @decl constant CRLF
   *!   Newline is carriage return, linefeed (CRLF)
   */
  add_integer_constant("CRLF",PCRE2_NEWLINE_CRLF,0);
  /*! @decl constant ANY
   *!   Newline is any Unicode line ending
   */
  add_integer_constant("ANY",PCRE2_NEWLINE_ANY,0);
  /*! @decl constant ANYCRLF
   *!   Newline is any of CR, LF, or CRLF
   */
  add_integer_constant("ANYCRLF",PCRE2_NEWLINE_ANYCRLF,0);
  /*! @decl constant NUL
   *!   Newline is the NUL character (binary zero)
   */
  add_integer_constant("NUL",PCRE2_NEWLINE_NUL,0);

#define END_PROGRAM_MAKE_SUBMODULE(X)                                   \
   do                                                                   \
   {                                                                    \
     struct program *p=end_program();                                   \
     struct object *obj=clone_object(p,0);                              \
     add_object_constant(X,obj,0);                                      \
     free_object(obj);                                                  \
     free_program(p);                                                   \
   }                                                                    \
   while (0)

  END_PROGRAM_MAKE_SUBMODULE("NEWLINE");

  /*! @endmodule NEWLINE
   */

  /*! @module OPTION
   *!  contains all option constants
   */

  start_new_program();

#ifdef PCRE2_ALLOW_EMPTY_CLASS
  /*! @decl optional constant ALLOW_EMPTY_CLASS
   *! (from the pcre2api manpage) By default, for compatibility with Perl,
   *! a closing square bracket thatimmediately follows an opening one is
   *! treated as a data character for the class. When ALLOW_EMPTY_CLASS is
   *! set, it terminates the class, which therefore contains no characters
   *! and so can never match.
   *!
   *! @note
   *!   This symbol is not present in all versions of PCRE2. It was
   *!   added in PCRE2 10.30.
   */
  add_integer_constant("ALLOW_EMPTY_CLASS",PCRE2_ALLOW_EMPTY_CLASS,
                       ID_OPTIONAL);
#endif

#ifdef PCRE2_ALT_BSUX
  /*! @decl optional constant ALT_BSUX
   *! (from the pcre2api manpage) This option request alternative handling
   *! of three escape sequences, which makes PCRE2's behaviour more like
   *! ECMAscript (aka JavaScript). When it is set:
   *! @ol
   *!   @item
   *!     \U matches an upper case "U" character; by default \U causes
   *!     a compile time error (Perl uses \U to upper case subsequent
   *!     characters).
   *!   @item
   *!     \u matches a lower case "u" character unless it is followed by
   *!     four hexadecimal digits, in which case the hexadecimal number
   *!     defines the code point to match. By default, \u causes a compile
   *!     time error (Perl uses it to upper case the following character).
   *!   @item
   *!     \x matches a lower case "x" character unless it is followed by
   *!     two hexadecimal digits, in which case the hexadecimal number
   *!     defines the code point to match. By default, as in Perl, a
   *!     hexadecimal number is always expected after \x, but it may have
   *!     zero, one, or two digits (so, for example, \xz matches a
   *!     binary zero character followed by z).
   *! @endol
   *!
   *! @note
   *!   This symbol is not present in all versions of PCRE2. It was
   *!   added in PCRE2 10.32.
   */
  add_integer_constant("ALT_BSUX",PCRE2_ALT_BSUX,
                       ID_OPTIONAL);
#endif

  /*! @decl constant ALT_CIRCUMFLEX
   *! (from the pcre2api manpage) In multiline mode (when @[MULTILINE]
   *! is set), the circumflex metacharacter matches at the start of the
   *! subject, and also after any internal newline. However, it does not
   *! match after a newline at the end of the subject, for compatibility
   *! with Perl. If you want a multiline circumflex also to match after
   *! a terminating newline, you must set ALT_CIRCUMFLEX.
   */
  add_integer_constant("ALT_CIRCUMFLEX",PCRE2_ALT_CIRCUMFLEX,0);

#ifdef PCRE2_ALT_EXTENDED_CLASS
  /*! @decl optional constant ALT_EXTENDED_CLASS
   *! (from the pcre2api manpage) Alters the parsing of character classes
   *! to follow the extended syntax described by Unicode UTS#18.
   *! The ALT_EXTENDED_CLASS option has no impact on the behaviour of the
   *! Perl-specific "(?[...])" syntax for extended classes, but instead
   *! enables the alternative syntax of extended class behaviour inside
   *! ordinary "[...]" character classes.
   *!
   *! @note
   *!   This symbol is not present in all versions of PCRE2. It was
   *!   added in PCRE2 10.45.
   */
  add_integer_constant("ALT_EXTENDED_CLASS",PCRE2_ALT_EXTENDED_CLASS,
                       ID_OPTIONAL);
#endif

  /*! @decl constant ALT_VERBNAMES
   *! (from the pcre2api manpage) By default, for compatibility with Perl,
   *! the name in any verb sequence such as (*MARK:NAME) is any sequence
   *! of characters that does not include a closing parenthesis. The name
   *! is not processed in any way, and it is not possible to include a
   *! closing parenthesis in the name. However, if the ALT_VERBNAMES
   *! option is set, normal backslash processing is applied to verb names
   *! and only an unescaped closing parenthesis terminates the name.
   *! A closing parenthesis can be included in a name either as \) or
   *! between \Q and \E. If the @[EXTENDED] or @[EXTENDED_MORE] option
   *! is set with ALT_VERBNAMES, unescaped whitespace in verb names is
   *! skipped and #-comments are recognized, exactly as in the rest of
   *! the pattern.
   */
  add_integer_constant("ALT_VERBNAMES",PCRE2_ALT_VERBNAMES,0);

  /*! @decl constant ANCHORED
   *! (from the pcre2api manpage) If this bit is set, the pattern is forced
   *! to be "anchored", that is, it is constrained to match only at the first
   *! matching point in the string that is being searched (the "subject
   *! string"). This effect can also be achieved by appropriate constructs
   *! in the pattern itself, which is the only way to do it in Perl.
   */
  add_integer_constant("ANCHORED",PCRE2_ANCHORED,0);

  /*! @decl constant AUTO_CALLOUT
   *! (from the pcre2api manpage) If this bit is set, callout items are
   *! automatically inserted, all with number 255, before each pattern item,
   *! except immediately before or after an explicit callout in the pattern.
   */
  add_integer_constant("AUTO_CALLOUT",PCRE2_AUTO_CALLOUT,0);

  /*! @decl constant CASELESS
   *! (from the pcre2api manpage) If this bit is set, letters in the
   *! pattern match both upper and lower case letters in the subject.
   *! It is equivalent to Perl's /i option, and it can be changed within
   *! a pattern by a (?i) option setting
   */
  add_integer_constant("CASELESS",PCRE2_CASELESS,0);

  /*! @decl constant DOLLAR_ENDONLY
   *! (from the pcre2api manpage) If this bit is set, a dollar
   *! metacharacter in the pattern matches only at the end of the subject
   *! string. Without this option, a dollar also matches immediately before
   *! a newline at the end of the string (but not before any other newlines).
   *! The DOLLAR_ENDONLY option is ignored if @[MULTILINE] is set.
   *! There is no equivalent to this option in Perl, and no way to set it
   *! within a pattern.
   */
  add_integer_constant("DOLLAR_ENDONLY",PCRE2_DOLLAR_ENDONLY,0);

  /*! @decl constant DOTALL
   *! (from the pcre2api manpage) If this bit is set, a dot metacharacter
   *! in the pattern matches any character, including one that indicates
   *! a newline. However, it only ever matches one character, even if
   *! newlines are coded as CRLF. Without this option, a dot does not match
   *! when the current position in the subject is at a newline. This option
   *! is equivalent to Perl's /s option, and it can be changed within a
   *! pattern by a (?s) option setting. A negative class such as [^a] always
   *! matches newline characters, and the \N escape sequence always matches a
   *! non-newline character, independent of the setting of DOTALL.
   */
  add_integer_constant("DOTALL",PCRE2_DOTALL,0);

  /*! @decl constant DUPNAMES
   *! (from the pcre2api manpage) If this bit is set, names used to identify
   *! capture groups need not be unique. This can be helpful for certain types
   *! of pattern when it is known that only one instance of the named group
   *! can ever be matched.
   */
  add_integer_constant("DUPNAMES",PCRE2_DUPNAMES,0);

  /*! @decl constant ENDANCHORED
   *! (from the pcre2api manpage) If this bit is set, the end of any pattern
   *! match must be right at the end of the string being searched (the
   *! "subject string"). If the pattern match succeeds by reaching (*ACCEPT),
   *! but does not reach the end of the subject, the match fails at the
   *! current starting point. For unanchored patterns, a new match is then
   *! tried at the next starting point. However, if the match succeeds by
   *! reaching the end of the pattern, but not the end of the subject,
   *! backtracking occurs and an alternative match may be found.
   */
  add_integer_constant("ENDANCHORED",PCRE2_ENDANCHORED,0);

  /*! @decl constant EXTENDED
   *! (from the pcre2api manpage) If this bit is set, most white space
   *! characters in the pattern are totally ignored except when escaped,
   *! inside a character class, or inside a \Q...\E sequence. However,
   *! white space is not allowed within sequences such as (?> that introduce
   *! various parenthesized groups, nor within numerical quantifiers such
   *! as {1,3}. Ignorable white space is permitted between an item and a
   *! following quantifier and between a quantifier and a following + that
   *! indicates possessiveness. EXTENDED is equivalent to Perl's /x option,
   *! and it can be changed within a pattern by a (?x) option setting.
   */
  add_integer_constant("EXTENDED",PCRE2_EXTENDED,0);

  /*! @decl constant EXTENDED_MORE
   *! (from the pcre2api manpage) This option has the effect of @[EXTENDED],
   *! but, in addition, unescaped space and horizontal tab characters are
   *! ignored inside a character class. Note: only these two characters are
   *! ignored, not the full set of pattern white space characters that are
   *! ignored outside a character class. EXTENDED_MORE is equivalent to
   *! Perl's /xx option, and it can be changed within a pattern by a
   *! (?xx) option setting.
   */
  add_integer_constant("EXTENDED_MORE",PCRE2_EXTENDED_MORE,0);

  /*! @decl constant FIRSTLINE
   *! (from the pcre2api manpage) If this option is set, the start of an
   *! unanchored pattern match must be before or at the first newline in
   *! the subject string following the start of matching, though the
   *! matched text may continue over the newline. If @tt{startoffset@} is
   *! non-zero, the limiting newline is not necessarily the first newline
   *! in the subject. For example, if the subject string is "abc\nxyz"
   *! (where \n represents a single-character newline) a pattern match for
   *! "yz" succeeds with FIRSTLINE if @tt{startoffset@} is greater than 3.
   */
  add_integer_constant("FIRSTLINE",PCRE2_FIRSTLINE,0);

#ifdef PCRE2_LITERAL
  /*! @decl optional constant LITERAL
   *! (from the pcre2api manpage) If this option is set, all
   *! meta-characters in the pattern are disabled, and it is
   *! treated as a literal string. Matching literal strings with
   *! a regular expression engine is not the most efficient way
   *!of doing it. If you are doing a lot of literal matching and
   *! are worried about efficiency, you should consider
   *! using other approaches.
   *!
   *! @note
   *!   This symbol is not present in all versions of PCRE2. It was
   *!   added in PCRE2 10.30.
   */
  add_integer_constant("LITERAL",PCRE2_LITERAL,
                       ID_OPTIONAL);
#endif

#ifdef PCRE2_MATCH_INVALID_UTF
  /*! @decl optional constant MATCH_INVALID_UTF
   *! (from the pcre2api manpage) This option forces @[UTF] (see below) and
   *! also enables support for matching in subject strings that contain
   *! invalid UTF sequences.
   *!
   *! @note
   *!   This symbol is not present in all versions of PCRE2. It was
   *!   added in PCRE2 10.34.
   */
  add_integer_constant("MATCH_INVALID_UTF",PCRE2_MATCH_INVALID_UTF,
                       ID_OPTIONAL);
#endif

  /*! @decl constant MATCH_UNSET_BACKREF
   *! (from the pcre2api manpage) If this option is set, a backreference
   *! to an unset capture group matches an empty string (by default this
   *! causes the current matching alternative to fail). A pattern such as
   *! (\1)(a) succeeds when this option is set (assuming it can find an
   *! "a" in the subject), whereas it fails by default, for Perl
   *! compatibility. Setting this option makes PCRE2 behave more like
   *! ECMAscript (aka JavaScript).
   */
  add_integer_constant("MATCH_UNSET_BACKREF",PCRE2_MATCH_UNSET_BACKREF,0);

  /*! @decl constant MULTILINE
   *! (from the pcre2api manpage) By default, for the purposes of matching
   *! "start of line" and "end of line", PCRE2 treats the subject string as
   *! consisting of a single line of characters, even if it actually contains
   *! newlines. The "start of line" metacharacter (^) matches only at the
   *! start of the string, and the "end of line" metacharacter ($) matches
   *! only at the end of the string, or before a terminating newline
   *! (except when DOLLAR_ENDONLY is set). Note, however, that unless
   *! @[DOTALL] is set, the "any character" metacharacter (.) does not match
   *! at a newline. This behaviour (for ^, $, and dot) is the same as Perl.
   *!
   *! When MULTILINE it is set, the "start of line" and "end of line"
   *! constructs match immediately following or immediately before internal
   *! newlines in the subject string, respectively, as well as at the very
   *! start and end. This is equivalent to Perl's /m option, and it can be
   *! changed within a pattern by a(?m) option setting. Note that the
   *! "start of line" metacharacter does not match after a newline at the
   *! end of the subject, for compatibility with Perl. However, you can
   *! change this by setting the @[ALT_CIRCUMFLEX] option. If there are no
   *! newlines in a subject string, or no occurrences of ^ or $ in a
   *! pattern, setting MULTILINE has no effect.
   */
  add_integer_constant("MULTILINE",PCRE2_MULTILINE,0);

  /*! @decl constant NEVER_BACKSLASH_C
   *! (from the pcre2api manpage) This option locks out the use of \C
   *! in the pattern that is being compiled. This escape can cause
   *! unpredictable behaviour in UTF-8 or UTF-16 modes, because
   *! it may leave the current matching point in the middle of a
   *! multi-code-unit character. This option may be useful in applications
   *! that process patterns from external sources. Note that there is also
   *! a build-time option that permanently locks out the use of \C.
   */
  add_integer_constant("NEVER_BACKSLASH_C",PCRE2_NEVER_BACKSLASH_C,0);

  /*! @decl constant NEVER_UCP
   *! (from the pcre2api manpage) This option locks out the use of Unicode
   *! properties for handling \B, \b, \D, \d, \S, \s, \W, \w, and some of
   *! the POSIX character classes, as described for the @[UCP] option below.
   *! In particular, it prevents the creator of the pattern from enabling
   *! this facility by starting the pattern with (*UCP). This option may be
   *! useful in applications that process patterns from external sources.
   *! The option combination @[UCP] and NEVER_UCP causes an error.
   */
  add_integer_constant("NEVER_UCP",PCRE2_NEVER_UCP,0);

  /*! @decl constant NEVER_UTF
   *! (from the pcre2api manpage) This option locks out interpretation of the
   *! pattern as UTF-8, UTF-16, or UTF-32. In particular, it prevents the
   *! creator of the pattern from switching to UTF interpretation by starting
   *! the pattern with (*UTF). This option may be useful in applications that
   *! process patterns from external sources. The combination of @[UTF] and
   *! NEVER_UTF causes an error.
   */
  add_integer_constant("NEVER_UTF",PCRE2_NEVER_UTF,0);

  /*! @decl constant NO_AUTO_CAPTURE
   *! (from the pcre2api manpage) If this option is set, it disables the
   *! use of numbered capturing parentheses in the pattern. Any opening
   *! parenthesis that is not followed by ? behaves as if it were followed
   *! by ?: but named parentheses can still be used for capturing (and
   *! they acquire numbers in the usual way). This is the same as Perl's
   *! /n option. Note that, when this option is set, references to capture
   *! groups (backreferences or recursion/subroutine calls) may only refer
   *! to named groups, though the reference can be by name or by number.
   */
  add_integer_constant("NO_AUTO_CAPTURE",PCRE2_NO_AUTO_CAPTURE,0);

  /*! @decl constant NO_AUTO_POSSESS
   *! (from the pcre2api manpage) If this (deprecated) option is set,
   *! it disables "auto-possessification", which is an optimization that,
   *! for example, turns a+b into a++b in order to avoid backtracks into
   *! a+ that can never be successful. However, if callouts are in use,
   *! auto-possessification means that some callouts are never taken. You can
   *! set this option if you want the matching functions to do a full
   *! unoptimized search and run all the callouts, but it is mainly provided
   *! for testing purposes.
   */
  add_integer_constant("NO_AUTO_POSSESS",PCRE2_NO_AUTO_POSSESS,0);

  /*! @decl constant NO_DOTSTAR_ANCHOR
   *! (from the pcre2api manpage) If this (deprecated) option is set,
   *! it disables an optimization that is applied when .* is the first
   *! significant item in a top-level branch of a pattern, and all the other
   *! branches also start with .* or with \A or \G or ^. The optimization
   *! is automatically disabled for .* if it is inside an atomic group
   *! or a capture group that is the subject of a backreference, or if the
   *! pattern contains (*PRUNE) or (*SKIP). When the optimization is not
   *! disabled, such a pattern is automatically anchored if @[DOTALL] is
   *! set for all the .* items and @[MULTILINE] is not set for any ^ items.
   *! Otherwise, the fact that any match must start either at the start of
   *! the subject or following a newline is remembered. Like other
   *! optimizations, this can cause callouts to be skipped.
   */
  add_integer_constant("NO_DOTSTAR_ANCHOR",PCRE2_NO_DOTSTAR_ANCHOR,0);

  /*! @decl constant NO_START_OPTIMIZE
   *! (from the pcre2api manpage) This is an option whose main effect is
   *! at matching time.
   *!
   *! There are a number of optimizations that may occur at the start of
   *! a match, in order to speed up the process. For example, if it is
   *! known that an unanchored match must start with a specific code unit
   *! value, the matching code searches the subject for that value, and
   *! fails immediately if it cannot find it, without actually running
   *! the main matching function. The start-up optimizations are in effect
   *! a pre-scan of the subject that takes place before the pattern is run.
   *!
   *! Disabling the start-up optimizations may cause performance to suffer.
   *! However, this may be desirable for patterns which contain callouts or
   *! items such as (*COMMIT) and (*MARK).
   */
  add_integer_constant("NO_START_OPTIMIZE",PCRE2_NO_START_OPTIMIZE,0);

  /*! @decl constant NO_UTF_CHECK
   *! (from the pcre2api manpage) When @[UTF] is set, the validity of the
   *! pattern as a UTF string is automatically checked.  If an invalid UTF
   *! sequence is found, an error is thrown.
   *!
   *! If you know that your pattern is a valid UTF string, and you want to
   *! skip this check for performance reasons, you can set the NO_UTF_CHECK
   *! option. When it is set, the effect of passing an invalid UTF string a
   *! s a pattern is undefined. It may cause your program to crash or loop.
   *!
   *! Note also that setting NO_UTF_CHECK at compile time does not disable
   *! the error that is given if an escape sequence for an invalid Unicode
   *! code point is encountered in the pattern. In particular, the so-called
   *! "surrogate" code points (0xd800 to 0xdfff) are invalid.
   */
  add_integer_constant("NO_UTF_CHECK",PCRE2_NO_UTF_CHECK,0);

  /*! @decl constant UCP
   *! (from the pcre2api manpage) This option has two effects.
   *! Firstly, it change the way PCRE2 processes \B, \b, \D, \d,
   *! \S, \s, \W, \w, and some of the POSIX character classes. By
   *! default, only ASCII characters are recognized, but if UCP is set,'
   *! Unicode properties are used to classify characters.
   *!
   *! The second effect of UCP is to force the use of Unicode properties for
   *! upper/lower casing operations, even when @[UTF] is not set. This makes
   *! it possible to process strings in the 16-bit UCS-2 code.
   *!
   *! In Pike the option is automatically enabled unless either @[UTF] or
   *! @[NEVER_UCP] is set.
   */
  add_integer_constant("UCP",PCRE2_UCP,0);

  /*! @decl constant UNGREEDY
   *! (from the pcre2api manpage) This option inverts the "greediness" of the
   *! quantifiers so that they are not greedy by default, but become greedy
   *! if followed by "?". It is not compatible with Perl. It can also be set
   *! by a (?U) option setting within the pattern.
   */
  add_integer_constant("UNGREEDY",PCRE2_UNGREEDY,0);

  /*! @decl constant UTF
   *! (from the pcre2api manpage) This option causes PCRE2 to regard
   *! both the pattern and the subject strings that are subsequently
   *! processed as strings of UTF characters instead of single-code-unit
   *! strings.
   */
  add_integer_constant("UTF",PCRE2_UTF,0);

   END_PROGRAM_MAKE_SUBMODULE("OPTION");

   /*! @endmodule OPTION
    */
  

   /*! @module CALLOUT
    */

   /*! @decl constant STARTMATCH
    *! @decl constant BACKTRACK
    *!  Documented in @[CalloutBlock()->callout_flags].
    */

   start_new_program();
   /* documented in callout_flags */
#ifdef PCRE2_CALLOUT_STARTMATCH
   add_integer_constant("STARTMATCH",PCRE2_CALLOUT_STARTMATCH,0);
#endif
#ifdef PCRE2_CALLOUT_BACKTRACK
   add_integer_constant("BACKTRACK",PCRE2_CALLOUT_BACKTRACK,0);
#endif

   END_PROGRAM_MAKE_SUBMODULE("CALLOUT");

   /*! @endmodule CALLOUT
    */
   
   /*! @module ERROR
    */

   /*! @decl constant NOMATCH
    *! @decl constant NULL
    *! @decl constant BADOPTION
    *! @decl constant BADMAGIC
    *! @decl constant NOMEMORY
    *! @decl constant NOSUBSTRING
    *! @decl constant MATCHLIMIT
    *! @decl constant HEAPLIMIT
    *! @decl constant CALLOUT
    *!   Documented in @[_pcre()->exec()].
    */

   start_new_program();
   /* documented in exec() */
   add_integer_constant("NOMATCH",PCRE2_ERROR_NOMATCH,0);
   add_integer_constant("NULL",PCRE2_ERROR_NULL,0);
   add_integer_constant("BADOPTION",PCRE2_ERROR_BADOPTION,0);
   add_integer_constant("BADMAGIC",PCRE2_ERROR_BADMAGIC,0);
   add_integer_constant("NOMEMORY",PCRE2_ERROR_NOMEMORY,0);
   add_integer_constant("NOSUBSTRING",PCRE2_ERROR_NOSUBSTRING,0);
#ifdef PCRE2_ERROR_MATCHLIMIT
   add_integer_constant("MATCHLIMIT",PCRE2_ERROR_MATCHLIMIT,0);
#endif
#ifdef PCRE2_ERROR_HEAPLIMIT
   add_integer_constant("HEAPLIMIT",PCRE2_ERROR_HEAPLIMIT,0);
#endif
#ifdef PCRE2_ERROR_CALLOUT
   add_integer_constant("CALLOUT",PCRE2_ERROR_CALLOUT,0);
#endif

   END_PROGRAM_MAKE_SUBMODULE("ERROR");

   /*! @endmodule ERROR
    */

   /*! @endmodule PCRE2
    */

   /*! @endmodule Regexp
    */

   INIT

#endif /* HAVE_LIBPCRE2 */
}
