START_MARKER
cond_begin([[ master()->resolv("Regexp.PCRE2.Plain") ]])

   test_eq(Regexp.PCRE2("b[^-]*m")->replace1("abam-boom-fooabadoom","gurka"),
           "agurka-boom-fooabadoom")
   test_eq(Regexp.PCRE2("b[^-]*m")->replace("abam-boom-fooabadoom","gurka"),
           "agurka-gurka-fooagurka")

   test_eq(Regexp.PCRE2("o+")->replace("foobar",""),"fbar");
   test_eq(Regexp.PCRE2("o*")->replace("foobar",""),"fbar");
   test_eq(Regexp.PCRE2("^o*")->replace("foobar",""),"foobar");
   test_eq(Regexp.PCRE2("o*$")->replace("foobar",""),"foobar");

   test_any_equal(
      array x=({});
      Regexp.PCRE2("o+")->matchall("foobar", lambda(mixed s) {
        x += ({ s });
      });
      return x*({});, ({"oo"}))

   test_any_equal(
      array x=({});
      Regexp.PCRE2("o*")->matchall("foobar", lambda(mixed s) {
        x += ({ s });
      });
      return x*({});, ({"","oo","","","",""}))

   test_equal([[Regexp.PCRE2 ("")->exec ("foo", 2)]], [[({2, 2})]])
   test_equal([[Regexp.PCRE2 ("")->exec ("foo", 3)]], [[({3, 3})]])
   test_equal([[Regexp.PCRE2 ("")->exec ("foo", 4)]], -1)
   test_equal([[Regexp.PCRE2 ("")->exec ("foo", 17)]], -1)

   test_equal([[Regexp.PCRE2 ("")->replace ("xyz", "123")]], "123x123y123z123")

test_any_equal([[
  // Crash bug reported by Eiichiro ITANI.
  object re = Regexp.PCRE2("(a)?(b)");
  return re->split("b");
]], [[({0, "b"})]])

test_equal([[Regexp.PCRE2 ("^(?:(.*b)|(.*c))$")->exec ("GERGXVb")]],
           [[({0, 7, 0, 7, -1, -1})]])
test_equal([[Regexp.PCRE2 ("^(?:(.*b)|(.*c))$")->exec ("GERGXVc")]],
           [[({0, 7, -1, -1, 0, 7})]])

test_eq(Regexp.PCRE2("\1234[^-]*m")->replace("a\1234\567m-\1234oom-fooa\1234adoom","g\1234rka"),
           "ag\1234rka-g\1234rka-fooag\1234rka")

dnl 8 bit pattern, 8 bit subject
test_equal(Regexp.PCRE2("[a].")->split2("blaha"), ({"ah"}))
dnl 16 bit pattern, 8 bit subject
test_equal(Regexp.PCRE2("[a\u3042].")->split2("blaha"), ({"ah"}))
dnl 32 bit pattern, 8 bit subject
test_equal(Regexp.PCRE2("[a\u3042\U0001F130].")->split2("blaha"), ({"ah"}))
dnl 8 bit pattern, 16 bit subject
test_equal( Regexp.PCRE2("[a].")->split2("toa\u308b"), ({"a\u308b"}))
dnl 16 bit pattern, 16 bit subject
test_equal(Regexp.PCRE2("[a\u3042].")->split2("\u3068\u3042\u308b"),
           ({"\u3042\u308b"}))
dnl 32 bit pattern, 16 bit subject
test_equal(Regexp.PCRE2("[a\u3042\U0001F130].")->split2("\u3068\u3042\u308b"),
           ({"\u3042\u308b"}))
dnl 8 bit pattern, 32 bit subject
test_equal(Regexp.PCRE2("[a].")->split2("bla\U0001F137a"),
           ({"a\u{1f137}"}))
dnl 16 bit pattern, 32 bit subject
test_equal(Regexp.PCRE2("[a\u3042].")->split2("bl\u3042\U0001F137a"),
           ({"\u3042\u{1f137}"}))
dnl 32 bit pattern, 32 bit subject
test_equal(Regexp.PCRE2("[a\u3042\U0001F130].")->
           split2("\U0001F131\U0001F13B\U0001F130\U0001F137\U0001F130"),
           ({"\u{1f130}\u{1f137}"}))

test_any_equal([[
  array a = ({});
  Regexp.PCRE2.MatchContext mcon = Regexp.PCRE2.MatchContext();
  mcon->set_callout(lambda(Regexp.PCRE2.CalloutBlock block) {
    a += ({ block, mkmapping(indices(block), values(block)) });
    // Flags will depend on e.g. JIT availability
    if (has_index(a[-1], "callout_flags") && intp(a[-1]->callout_flags))
       a[-1]->callout_flags = 0;
    return 0;
  });
  return ({
    Regexp.PCRE2("((a)(*MARK:Levengood)(b))(?C17)[ck]*(d)(?C'owari')")->
      match("0123456789abcdef", 0, mcon)
  }) + a;
]], [[({ 1, 0, ([
  "callout_flags": 0,
  "callout_number": 17,
  "callout_string": 0,
  "callout_string_offset": 0,
  "capture_last": 1,
  "capture_top": 4,
  "current_position": 12,
  "mark": "Levengood",
  "next_item_length": 5,
  "offset_vector": ({
        -1,
        -1,
        10,
        12,
        10,
        11,
        11,
        12
    }),
  "pattern_position": 31,
  "start_match": 10,
  "subject": "0123456789abcdef"
]), 0, ([
  "callout_flags": 0,
  "callout_number": 0,
  "callout_string": "owari",
  "callout_string_offset": 43,
  "capture_last": 4,
  "capture_top": 5,
  "current_position": 14,
  "mark": "Levengood",
  "next_item_length": 0,
  "offset_vector": ({ /* 10 elements */
        -1,
        -1,
        10,
        12,
        10,
        11,
        11,
        12,
        13,
        14
    }),
  "pattern_position": 50,
  "start_match": 10,
  "subject": "0123456789abcdef"
])})]])

cond_end // Regexp.PCRE2.Plain

END_MARKER
